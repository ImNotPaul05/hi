local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local gui = player.PlayerGui

-- ClientData
local ClientData = require(
    ReplicatedStorage
        :WaitForChild("ClientModules")
        :WaitForChild("Core")
        :WaitForChild("ClientData")
)

local data = ClientData.get_data()
local playerData = data[player] or data[player.Name]

local pets = playerData.inventory.pets
local journal = gui:FindFirstChild("JournalApp")

if not journal then
    warn("JournalApp not found")
    return
end

local rarities = {
    common = "Common",
    uncommon = "UnCommon",
    rare = "Rare",
    ultra_rare = "Ultra_Rare",
    legendary = "Legendary",
}

local function getRarityFromPath(obj)
    local current = obj

    while current and current ~= journal do
        local rarity = rarities[string.lower(current.Name)]

        if rarity then
            return rarity
        end

        current = current.Parent
    end

    return nil
end

local function findJournalPet(kind)
    for _, obj in ipairs(journal:GetDescendants()) do
        -- Pet entry itself may be named with its kind
        if obj.Name == kind then
            return obj
        end

        -- Or it may have the kind as an attribute
        for _, value in pairs(obj:GetAttributes()) do
            if value == kind then
                return obj
            end
        end

        -- Or a StringValue inside it may contain the kind
        if obj:IsA("StringValue") and obj.Value == kind then
            return obj
        end
    end

    return nil
end

local counts = {
    Common = 0,
    UnCommon = 0,
    Rare = 0,
    Ultra_Rare = 0,
    Legendary = 0,
}

local checkedKinds = {}

for uniqueId, petData in pairs(pets) do
    local kind = petData and petData.kind

    if kind and not checkedKinds[kind] then
        checkedKinds[kind] = true

        local journalPet = findJournalPet(kind)

        if journalPet then
            local rarity = getRarityFromPath(journalPet)

            print(
                kind,
                "=>",
                rarity or "RARITY NOT FOUND",
                "|",
                journalPet:GetFullName()
            )

            if rarity then
                counts[rarity] += 1
            end
        else
            print(kind, "=> JOURNAL PET NOT FOUND")
        end
    end
end

print("===== RARITY COUNTS =====")
print("Common:", counts.Common)
print("UnCommon:", counts.UnCommon)
print("Rare:", counts.Rare)
print("Ultra_Rare:", counts.Ultra_Rare)
print("Legendary:", counts.Legendary)
