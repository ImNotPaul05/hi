-- Flight Engine Logic
local function startFlight()
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    flying = true
    flyButton.Text = "Fly: ON"
    flyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    
    if humanoid then humanoid.PlatformStand = true end
    
    if hrp:FindFirstChild("EmulatorVel") then hrp.EmulatorVel:Destroy() end
    if hrp:FindFirstChild("EmulatorGyro") then hrp.EmulatorGyro:Destroy() end
    
    bodyVel = Instance.new("BodyVelocity")
    bodyVel.Name = "EmulatorVel"
    bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVel.Velocity = Vector3.new(0, 0.1, 0)
    bodyVel.Parent = hrp
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.Name = "EmulatorGyro"
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.CFrame = hrp.CFrame
    bodyGyro.Parent = hrp
end

local function stopFlight()
    flying = false
    flyButton.Text = "Fly: OFF"
    flyButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    
    local character = localPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.PlatformStand = false end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            if hrp:FindFirstChild("EmulatorVel") then hrp.EmulatorVel:Destroy() end
            if hrp:FindFirstChild("EmulatorGyro") then hrp.EmulatorGyro:Destroy() end
        end
    end
end

flyButton.MouseButton1Click:Connect(function()
    if flying then stopFlight() else startFlight() end
end)

-- Button Click Handlers for Emulator Touch/Mouse
fwdButton.MouseButton1Down:Connect(function() moveForward = true end)
fwdButton.MouseButton1Up:Connect(function() moveForward = false end)
upButton.MouseButton1Down:Connect(function() moveUp = true end)
upButton.MouseButton1Up:Connect(function() moveUp = false end)
downButton.MouseButton1Down:Connect(function() moveDown = true end)
downButton.MouseButton1Up:Connect(function() moveDown = false end)

-- Movement Step Loop
RunService.RenderStepped:Connect(function()
    if not flying or not bodyVel or not bodyGyro then return end
    
    local camCF = camera.CFrame
    local velocity = Vector3.new(0, 0.1, 0) -- anti-sunk hover
    
    if moveForward then
        velocity = camCF.LookVector * speed
    end
    if moveUp then
        velocity = velocity + Vector3.new(0, speed, 0)
    end
    if moveDown then
        velocity = velocity - Vector3.new(0, speed, 0)
    end
    
    bodyVel.Velocity = velocity
    bodyGyro.CFrame = camCF
end)

print("Emulator Fly GUI Loaded!")
