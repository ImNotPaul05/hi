local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function inspectModule(path, name)
    local module = path
    local ok, result = pcall(require, module)

    print("\n==========", name, "==========")

    if not ok then
        warn("REQUIRE FAILED:", result)
        return
    end

    if type(result) ~= "table" then
        print("RETURN TYPE:", typeof(result))
        print("VALUE:", result)
        return
    end

    for key, value in pairs(result) do
        print(
            tostring(key),
            "=",
            typeof(value),
            type(value) == "table" and ("table:" .. tostring(value)) or tostring(value)
        )

        if type(value) == "table" then
            local count = 0

            for k, v in pairs(value) do
                print("   ", tostring(k), "=", typeof(v), tostring(v))
                count += 1

                if count >= 10 then
                    print("   ...")
                    break
                end
            end
        end
    end
end

