local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

-- ClientData
local ClientData = require(
    ReplicatedStorage
        :WaitForChild("ClientModules")
        :WaitForChild("Core")
        :WaitForChild("ClientData")
)

local data = ClientData.get_data()
local playerData = data[player] or data[player.Name]

local pets = playerData.inventory.pets

-- Journal
local content = player.PlayerGui
    .JournalApp
    .Book
    .Category
    .Body
    .ScrollComplex
    .ScrollingFrame
    .Content

local rarityNames = {
    common = "Common",
    uncommon = "UnCommon",
    rare = "Rare",
    ultra_rare = "Ultra_Rare",
    legendary = "Legendary",
}

local kindRarity = {}

-- Find which rarity section contains each Journal pet kind
for sectionName, rarity in pairs(rarityNames) do
    local section

    for _, obj in ipairs(content:GetChildren()) do
        if string.lower(obj.Name) == sectionName then
            section = obj
            break
        end
    end

    if section then
        for _, obj in ipairs(section:GetDescendants()) do
            local kind = obj.Name

            -- Ignore normal UI objects
            if kind ~= "Row0"
                and kind ~= "Row1"
                and kind ~= "Row2"
                and kind ~= "GridFrame"
                and kind ~= "UIListLayout"
                and kind ~= "UIGridLayout"
                and kind ~= "Spacer"
                and kind ~= "MiddleSpacer" then

                -- Only treat it as a pet if it is a Frame/ImageButton/etc.
                if obj:IsA("GuiObject") then
                    kindRarity[kind] = rarity
                end
            end
        end
    end
end

-- Count owned pets
local counts = {
    Common = 0,
    UnCommon = 0,
    Rare = 0,
    Ultra_Rare = 0,
    Legendary = 0,
}

local notFound = {}

for uniqueId, petData in pairs(pets) do
    local kind = petData and petData.kind

    if kind then
        local rarity = kindRarity[kind]

        if rarity then
            counts[rarity] += 1
        else
            table.insert(notFound, kind)
        end
    end
end

print("===== RARITY COUNTS =====")
print("Common:", counts.Common)
print("UnCommon:", counts.UnCommon)
print("Rare:", counts.Rare)
print("Ultra_Rare:", counts.Ultra_Rare)
print("Legendary:", counts.Legendary)

if #notFound > 0 then
    print("===== NOT FOUND IN JOURNAL =====")
    for _, kind in ipairs(notFound) do
        print(kind)
    end
end
