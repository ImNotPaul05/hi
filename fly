local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

-- Get inventory
local ClientData = require(
    ReplicatedStorage
        :WaitForChild("ClientModules")
        :WaitForChild("Core")
        :WaitForChild("ClientData")
)

local data = ClientData.get_data()
local playerData = data[player] or data[player.Name]

local pets = playerData.inventory.pets

-- Journal content
local content = player.PlayerGui
    .JournalApp
    .Book
    .Category
    .Body
    .ScrollComplex
    .ScrollingFrame
    .Content

local raritySections = {
    Common = {"common", "Common"},
    UnCommon = {"uncommon", "Uncommon"},
    Rare = {"rare", "Rare"},
    Ultra_Rare = {"ultra_rare", "Ultra_Rare", "ultra rare", "Ultra Rare"},
    Legendary = {"legendary", "Legendary"},
}

local function findRarity(kind)
    local wanted = string.lower(kind)

    for rarity, names in pairs(raritySections) do
        for _, sectionName in ipairs(names) do
            for _, section in ipairs(content:GetChildren()) do
                if string.lower(section.Name) == string.lower(sectionName) then

                    for _, obj in ipairs(section:GetDescendants()) do
                        if string.lower(obj.Name) == wanted then
                            return rarity
                        end
                    end

                end
            end
        end
    end

    return nil
end

-- Test Storm Condor
print("===== STORM CONDOR TEST =====")
print("Storm Condor rarity:", findRarity("storm condor"))

-- Count inventory
local counts = {
    Common = 0,
    UnCommon = 0,
    Rare = 0,
    Ultra_Rare = 0,
    Legendary = 0,
}

for uniqueId, petData in pairs(pets) do
    local kind = petData and petData.kind

    if kind then
        local rarity = findRarity(kind)

        if rarity then
            counts[rarity] += 1
        else
            warn("Rarity not found for:", kind)
        end
    end
end

print("===== INVENTORY RARITY COUNT =====")
print("Common:", counts.Common)
print("UnCommon:", counts.UnCommon)
print("Rare:", counts.Rare)
print("Ultra_Rare:", counts.Ultra_Rare)
print("Legendary:", counts.Legendary)
