local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TARGET_FAST_ID = 1510

print("================================")
print("SEARCHING FOR FAST ID:", TARGET_FAST_ID)
print("================================")

local function scanTable(tbl, path, depth, visited)
    if type(tbl) ~= "table" then
        return
    end

    if depth > 8 then
        return
    end

    visited = visited or {}

    if visited[tbl] then
        return
    end

    visited[tbl] = true

    for key, value in pairs(tbl) do
        if value == TARGET_FAST_ID then
            print("")
            print("========== MATCH ==========")
            print("Path:", path)
            print("Key:", key)
            print("Value:", value)
            print("============================")
        end

        if type(key) == "number" and key == TARGET_FAST_ID then
            print("")
            print("========== KEY MATCH ==========")
            print("Path:", path)
            print("Key:", key)
            print("Value:", value)
            print("===============================")
        end

        if type(value) == "table" then
            scanTable(
                value,
                path .. "." .. tostring(key),
                depth + 1,
                visited
            )
        end
    end
end

-- Search ClientData
local success, ClientData = pcall(function()
    return require(
        ReplicatedStorage
            :WaitForChild("ClientModules")
            :WaitForChild("Core")
            :WaitForChild("ClientData")
    )
end)

if success and ClientData then
    print("Searching ClientData...")
    scanTable(
        ClientData,
        "ClientData",
        0
    )
end

-- Search ModuleScripts under ReplicatedStorage
local modules = 0

for _, obj in ipairs(
    ReplicatedStorage:GetDescendants()
) do

    if obj:IsA("ModuleScript") then
        modules += 1

        local ok, result = pcall(require, obj)

        if ok and type(result) == "table" then
            scanTable(
                result,
                obj:GetFullName(),
                0
            )
        end
    end
end

print("")
print("================================")
print("Modules scanned:", modules)
print("SEARCH FINISHED")
print("================================")
