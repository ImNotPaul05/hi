local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local Config = {
    Pet = "summer_2026_storm_condor",
    Food = "Age-Up Potion",

    FeedDelay = 0.5,
    CheckDelay = 0.25,
}

--==================================================
-- REMOTES
--==================================================

local API = ReplicatedStorage:WaitForChild("API")

local EquipRemote =
    API:WaitForChild("ToolAPI/Equip")

local ConsumeFoodRemote =
    API:WaitForChild("PetAPI/ConsumeFoodObject")

local CreatePetObjectRemote =
    API:WaitForChild("PetObjectAPI/CreatePetObject")

