local Config = {
    TargetUsername = "XzMysticbAClawnzX",
}

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local furniture = Workspace
    :WaitForChild("HouseInteriors")
    :WaitForChild("furniture")

local targetPrefix = Config.TargetUsername .. "/"

-- UUID format:
-- xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
local UUID_PATTERN =
    "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"

local mannequinFolder
local furnitureId
local mannequin

--==================================================
-- FIND TARGET USER'S f-* FURNITURE
--==================================================

for _, obj in ipairs(furniture:GetChildren()) do

    -- Must belong to the configured username
    if obj.Name:sub(1, #targetPrefix) == targetPrefix then

        -- Accept ANY f-* identifier
        local id = obj.Name:match("(f%-.+)$")

        if id then

            -- Must contain a Mannequin somewhere inside
            local foundMannequin =
                obj:FindFirstChild("Mannequin", true)

            if foundMannequin then
                mannequinFolder = obj
                furnitureId = id
                mannequin = foundMannequin

                print("================================")
                print("MANNEQUIN FOUND")
                print("================================")
                print("Username:", Config.TargetUsername)
                print("Folder:", obj:GetFullName())
                print("Furniture ID:", furnitureId)
                print("Mannequin:", mannequin:GetFullName())

                break
            end
        end
    end
end

if not mannequinFolder then
    warn(
        "No f-* furniture containing a Mannequin found for "
        .. Config.TargetUsername
    )

    return
end

--==================================================
-- FIND UUID
--==================================================

local function findUUID(root)

    -- Check root attributes
    for name, value in pairs(root:GetAttributes()) do

        if typeof(value) == "string"
            and value:match(UUID_PATTERN)
        then
            return value, root, "Attribute: " .. name
        end
    end

    -- Check descendants
    for _, obj in ipairs(root:GetDescendants()) do

        -- Attributes
        for name, value in pairs(obj:GetAttributes()) do

            if typeof(value) == "string"
                and value:match(UUID_PATTERN)
            then
                return value, obj, "Attribute: " .. name
            end
        end

        -- StringValue
        if obj:IsA("StringValue") then

            if obj.Value:match(UUID_PATTERN) then
                return obj.Value, obj, "StringValue"
            end
        end
    end

    return nil
end

local outfitUUID
local uuidSource
local uuidSourceType

outfitUUID,
uuidSource,
uuidSourceType = findUUID(mannequinFolder)

--==================================================
-- PRINT RESULT
--==================================================

print("")
print("================================")
print("RESULT")
print("================================")
print("Target Username:", Config.TargetUsername)
print("Furniture ID:", furnitureId)

if outfitUUID then

    print("Outfit UUID:", outfitUUID)
    print("UUID Source:", uuidSource:GetFullName())
    print("UUID Type:", uuidSourceType)

else

    warn("Outfit UUID was NOT found.")
    print("Furniture was found successfully:")
    print("  ", furnitureFolder and furnitureFolder:GetFullName())
    print("  Furniture ID:", furnitureId)
    print("  Mannequin:", mannequin:GetFullName())

end
