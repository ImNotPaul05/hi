local function DHDF_fake_script() -- CosnoleButton.ConsoleScript 
	local script = Instance.new('LocalScript', CosnoleButton)

	local StarterGui = game:GetService("StarterGui")
	
	local button = script.Parent
	if not button:IsA("TextButton") then
		return
	end
	
	local function openDeveloperConsole()
		for _ = 1, 10 do
			local success, errorMessage = pcall(function()
				StarterGui:SetCore("DevConsoleVisible", true)
			end)
	
			if success then
				return
			end
	
			task.wait(0.25)
			if errorMessage then
				warn("Could not open Developer Console: " .. errorMessage)
			end
		end
	end
	
	button.Activated:Connect(openDeveloperConsole)
	
end
coroutine.wrap(DHDF_fake_script)()
