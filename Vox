local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local Config = {
    Pet = "summer_2026_storm_condor",
    PetForm = "normal", -- "normal" or "neon"

    -- Maximum number of Age-Up Potions to request
    MaxPotionBatch = 15,

    -- Delay after using a batch
    FeedDelay = 0.5,
}

--------------------------------------------------
-- AGE LISTS
--------------------------------------------------

local NormalAges = {
    "Newborn",
    "Junior",
    "Pre-Teen",
    "Teen",
    "Post-Teen",
    "Full Grown",
}

local NeonAges = {
    "Reborn",
    "Twinkle",
    "Sparkle",
    "Flare",
    "Sunshine",
    "Luminous",
}

--------------------------------------------------
-- LOAD CLIENT DATA
--------------------------------------------------

local successClientData, ClientData = pcall(function()
    return require(
        ReplicatedStorage
            :WaitForChild("ClientModules")
            :WaitForChild("Core")
            :WaitForChild("ClientData")
    )
end)

if not successClientData or not ClientData then
    warn("Failed to load ClientData")
    return
end

print("ClientData loaded:", ClientData)

--------------------------------------------------
-- GET PLAYER DATA
--------------------------------------------------

local function GetPlayerData()

    local dataStore = ClientData.get_data()

    if not dataStore then
        return nil
    end

    return dataStore[LocalPlayer]
        or dataStore[LocalPlayer.Name]
end

--------------------------------------------------
-- GET MATCHING PETS
--------------------------------------------------

local function GetMatchingPets()

    local playerData = GetPlayerData()

    if not playerData
        or not playerData.inventory
        or not playerData.inventory.pets then

        warn("Could not find pet inventory")
        return {}
    end

    local pets = {}

    for uniqueId, itemData in pairs(playerData.inventory.pets) do

        if itemData
            and itemData.kind == Config.Pet then

            local properties = itemData.properties or {}

            local isNeon = properties.neon == true
            local isMega = properties.mega_neon == true

            --------------------------------------------------
            -- NORMAL PET
            --------------------------------------------------

            if Config.PetForm == "normal" then

                if not isNeon and not isMega then
                    table.insert(pets, uniqueId)
                end

            --------------------------------------------------
            -- NEON PET
            --------------------------------------------------

            elseif Config.PetForm == "neon" then

                if isNeon and not isMega then
                    table.insert(pets, uniqueId)
                end

            end
        end
    end

    return pets
end

--------------------------------------------------
-- EQUIP ITEM
--------------------------------------------------

local function EquipItem(uniqueId)

    if not uniqueId then
        return false
    end

    local args = {
        uniqueId,
        {
            use_sound_delay = false,
            equip_as_last = false
        }
    }

    local success, result = pcall(function()

        return ReplicatedStorage
            :WaitForChild("API")
            :WaitForChild("ToolAPI/Equip")
            :InvokeServer(unpack(args))

    end)

    if not success then
        warn("Equip failed:", result)
        return false
    end

    return true
end

--------------------------------------------------
-- GET CURRENT AGE
--------------------------------------------------

local function GetCurrentAge()

    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")

    if not PlayerGui then
        return nil
    end

    local BackpackApp = PlayerGui:FindFirstChild("BackpackApp")

    if not BackpackApp then
        return nil
    end

    local ageList

    if Config.PetForm == "normal" then
        ageList = NormalAges
    else
        ageList = NeonAges
    end

    local AgeContainer = BackpackApp:FindFirstChild("Age", true)

    if not AgeContainer then
        return nil
    end

    for _, ageName in ipairs(ageList) do

        for _, object in ipairs(AgeContainer:GetDescendants()) do

            if object.Name == ageName then

                if object:IsA("GuiObject") then

                    if object.Visible then
                        return ageName
                    end

                else
                    return ageName
                end
            end
        end
    end

    return nil
end

--------------------------------------------------
-- WAIT FOR AGE
--------------------------------------------------

local function WaitForCurrentAge()

    for _ = 1, 30 do

        local age = GetCurrentAge()

        if age then
            return age
        end

        task.wait(0.1)
    end

    return nil
end

--------------------------------------------------
-- CHECK MAX AGE
--------------------------------------------------

local function IsMaxAge(age)

    if Config.PetForm == "normal" then
        return age == "Full Grown"
    end

    if Config.PetForm == "neon" then
        return age == "Luminous"
    end

    return false
end

--------------------------------------------------
-- GET AGE-UP POTION IDs
--
-- Gets them directly from:
--
-- ClientData
--   inventory
--      food
--
-- kind = "pet_age_potion"
--------------------------------------------------

local function GetAgeUpPotions(maxAmount)

    local playerData = GetPlayerData()

    if not playerData
        or not playerData.inventory
        or not playerData.inventory.food then

        return {}
    end

    local potionIds = {}

    for uniqueId, itemData in pairs(playerData.inventory.food) do

        if itemData
            and itemData.kind == "pet_age_potion" then

            table.insert(potionIds, uniqueId)

            if #potionIds >= maxAmount then
                break
            end
        end
    end

    return potionIds
end

--------------------------------------------------
-- USE AGE-UP POTION
--
-- The first potion:
--     unique_id
--
-- Additional potions:
--     additional_consume_uniques
--
-- Your captured API showed this structure.
--------------------------------------------------

local function UseAgeUpPotions(petUniqueId)

    --------------------------------------------------
    -- GET UP TO 15 FRESH POTION IDs
    --------------------------------------------------

    local potionIds =
        GetAgeUpPotions(Config.MaxPotionBatch)

    if #potionIds == 0 then

        warn("No Age-Up Potions remaining.")

        return false
    end

    print("")
    print("Potions selected:", #potionIds)

    for index, potionId in ipairs(potionIds) do
        print("Potion", index, ":", potionId)
    end

    --------------------------------------------------
    -- FIRST POTION
    --------------------------------------------------

    local firstPotionId = potionIds[1]

    --------------------------------------------------
    -- ADDITIONAL POTIONS
    --------------------------------------------------

    local additionalPotions = {}

    for index = 2, #potionIds do

        table.insert(
            additionalPotions,
            potionIds[index]
        )
    end

    --------------------------------------------------
    -- START POTION
    --
    -- This is the API you captured:
    --
    -- ServerUseTool(potionID, "START")
    --------------------------------------------------

    print("Starting Age-Up Potion:", firstPotionId)

    local startArgs = {
        firstPotionId,
        "START"
    }

    local startSuccess, startResult = pcall(function()

        return ReplicatedStorage
            :WaitForChild("API")
            :WaitForChild("ToolAPI/ServerUseTool")
            :InvokeServer(unpack(startArgs))

    end)

    if not startSuccess then

        warn(
            "ServerUseTool failed:",
            startResult
        )

        return false
    end

    task.wait(0.2)

    --------------------------------------------------
    -- CREATE PET OBJECT
    --------------------------------------------------

    local character = LocalPlayer.Character

    if not character then
        warn("Character not found")
        return false
    end

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not root then
        warn("HumanoidRootPart not found")
        return false
    end

    --------------------------------------------------
    -- CREATE PET OBJECT
    --------------------------------------------------

    local args = {
        "__Enum_PetObjectCreatorType_2",
        {
            additional_consume_uniques = additionalPotions,
            pet_unique = petUniqueId,
            spawn_cframe = root.CFrame,
            unique_id = firstPotionId
        }
    }

    print(
        "Creating pet object with",
        #potionIds,
        "potion(s)"
    )

    local success, result = pcall(function()

        return ReplicatedStorage
            :WaitForChild("API")
            :WaitForChild("PetObjectAPI/CreatePetObject")
            :InvokeServer(unpack(args))

    end)

    if not success then

        warn(
            "CreatePetObject failed:",
            result
        )

        return false
    end

    return true
end

--------------------------------------------------
-- AGE ONE PET
--------------------------------------------------

local function AgePet(
    petUniqueId,
    petNumber
)

    print("")
    print("========================================")
    print("PET", petNumber)
    print("Unique ID:", petUniqueId)
    print("========================================")

    --------------------------------------------------
    -- EQUIP PET
    --------------------------------------------------

    print("Equipping pet...")

    if not EquipItem(petUniqueId) then

        warn("Failed to equip pet.")

        return false
    end

    task.wait(0.5)

    --------------------------------------------------
    -- GET AGE
    --------------------------------------------------

    local currentAge =
        WaitForCurrentAge()

    if not currentAge then

        warn(
            "Could not determine current age."
        )

        return false
    end

    print("Current age:", currentAge)

    --------------------------------------------------
    -- ALREADY MAX
    --------------------------------------------------

    if IsMaxAge(currentAge) then

        print("Pet is already max age.")
        print("Skipping.")

        return true
    end

    --------------------------------------------------
    -- KEEP AGING
    --------------------------------------------------

    while true do

        --------------------------------------------------
        -- USE UP TO 15 POTIONS
        --------------------------------------------------

        print("")
        print("Current age:", currentAge)
        print(
            "Requesting up to",
            Config.MaxPotionBatch,
            "potions..."
        )

        local success =
            UseAgeUpPotions(petUniqueId)

        if not success then

            warn(
                "Unable to use Age-Up Potions."
            )

            return false
        end

        --------------------------------------------------
        -- WAIT FOR AGE UPDATE
        --------------------------------------------------

        task.wait(Config.FeedDelay)

        --------------------------------------------------
        -- RE-EQUIP SAME PET
        --------------------------------------------------

        print("Re-equipping pet...")

        if not EquipItem(petUniqueId) then

            warn(
                "Failed to re-equip pet."
            )

            return false
        end

        task.wait(0.5)

        --------------------------------------------------
        -- READ NEW AGE
        --------------------------------------------------

        currentAge =
            WaitForCurrentAge()

        if not currentAge then

            warn(
                "Could not determine new age."
            )

            return false
        end

        print("New age:", currentAge)

        --------------------------------------------------
        -- MAX?
        --------------------------------------------------

        if IsMaxAge(currentAge) then

            print("")
            print("========================================")
            print("PET", petNumber, "MAX AGE!")
            print("Final age:", currentAge)
            print("========================================")

            return true
        end

        --------------------------------------------------
        -- NOT MAX
        --------------------------------------------------

        print(
            "Pet is still growing:",
            currentAge
        )

    end
end

--------------------------------------------------
-- MAIN
--------------------------------------------------

print("")
print("========================================")
print("AUTO AGE STARTED")
print("========================================")
print("Pet:", Config.Pet)
print("Form:", Config.PetForm)
print(
    "Maximum potion batch:",
    Config.MaxPotionBatch
)
print("========================================")

--------------------------------------------------
-- FIND PETS
--------------------------------------------------

local pets = GetMatchingPets()

print(
    "Matching pets found:",
    #pets
)

if #pets == 0 then

    warn(
        "No matching pets found:",
        Config.Pet
    )

    return
end

--------------------------------------------------
-- PROCESS ALL PETS
--------------------------------------------------

for index, petUniqueId in ipairs(pets) do

    local success =
        AgePet(
            petUniqueId,
            index
        )

    --------------------------------------------------
    -- STOP IF POTIONS RUN OUT
    --------------------------------------------------

    if not success then

        warn(
            "Auto-age stopped at pet:",
            index
        )

        break
    end

    task.wait(0.5)
end

--------------------------------------------------
-- DONE
--------------------------------------------------

print("")
print("========================================")
print("AUTO AGE FINISHED")
print("========================================")
