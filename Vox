local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local Config = {
    Pet = "summer_2026_storm_condor",
    PetForm = "normal", -- "normal" or "neon"

    -- Maximum number of Age-Up Potions to request
    MaxPotionBatch = 15,

    -- Delay after using a batch
    FeedDelay = 0.5,
}

