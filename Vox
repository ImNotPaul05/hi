	local Players = game:GetService("Players")
	local localPlayer = Players.LocalPlayer
	local panel = script.Parent
	local refreshButton = panel.Parent:WaitForChild("RefreshEgg/Button")
	local selectedEggs = Instance.new("Folder")
	selectedEggs.Name = "SelectedEggs"
	selectedEggs.Parent = panel

	local list = Instance.new("ScrollingFrame")
	list.Name = "EggList"
	list.Parent = panel
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(8, 8)
	list.Size = UDim2.new(1, -16, 1, -16)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.ScrollBarThickness = 6

	local layout = Instance.new("UIListLayout")
	layout.Parent = list
	layout.Padding = UDim.new(0, 5)
	layout.SortOrder = Enum.SortOrder.LayoutOrder

	local successClientData, ClientData = pcall(function()
		return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("Core"):WaitForChild("ClientData"))
	end)
	local selectedGroups = {}

	local function removeEventPrefix(displayName)
		local text = tostring(displayName)
		-- Replace underscores and hyphens with spaces
		text = text:gsub("[_%-]", " ")
		-- Remove 4-digit years (like 2026)
		text = text:gsub("%d%d%d%d", "")
		-- Clean up extra spaces
		text = text:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
		return text
	end

	local function capitalizeWords(displayName)
		local text = displayName:gsub("(%S+)", function(word)
			return word:sub(1, 1):upper() .. word:sub(2):lower()
		end)
		-- Remove consecutive duplicate words anywhere (e.g., "Egg Egg" -> "Egg")
		text = text:gsub("(%a+)%s+%1", "%1")
		return text
	end

	local function getDisplayName(itemData)
		local properties = itemData.properties or {}
		local displayName = properties.name
			or properties.custom_name
			or properties.display_name
			or itemData.display_name
			or itemData.displayName
			or itemData.name
			or itemData.kind
			or "Unknown egg"

		local cleanedName = removeEventPrefix(displayName)
		return capitalizeWords(cleanedName)
	end

	local function isEgg(itemData)
		local kind = string.lower(tostring(itemData.kind or ""))
		local displayName = string.lower(tostring(itemData.display_name or itemData.displayName or itemData.name or ""))
		local category = string.lower(tostring(itemData.category or ""))
		
		-- Exclude pet items (such as basic_egg_2022_parakeet or basic_egg_2022_ancient_dragon) from appearing in the egg list
		if string.find(kind, "_egg_20", 1, true) then
			return false
		end

		if string.find(kind, "starter_egg", 1, true) then
			return false
		end

		return itemData.is_egg == true
			or string.find(kind, "egg", 1, true) ~= nil
			or string.find(displayName, "egg", 1, true) ~= nil
			or category == "egg"
			or category == "eggs"
	end
	
	local function clearList()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		selectedGroups = {}
		selectedEggs:ClearAllChildren()
	end

	local function syncSelectedEggs()
		selectedEggs:ClearAllChildren()
		local selectedIndex = 0
		for group in pairs(selectedGroups) do
			for index = 1, math.min(#group.uniqueIds, 18) do
				selectedIndex += 1
				local eggId = Instance.new("StringValue")
				eggId.Name = "Egg_" .. selectedIndex
				eggId.Value = tostring(group.uniqueIds[index])
				eggId.Parent = selectedEggs
			end
		end
	end

	local function refreshEggs()
		clearList()
		if not successClientData or not ClientData then
			return
		end

		local dataStore = ClientData.get_data()
		local playerData = dataStore and (dataStore[localPlayer] or dataStore[localPlayer.Name])
		local pets = playerData and playerData.inventory and playerData.inventory.pets
		if not pets then
			return
		end

		local groupedEggs = {}
		for uniqueId, itemData in pairs(pets) do
			if itemData and isEgg(itemData) then
				local displayName = getDisplayName(itemData)
				local key = displayName
				local group = groupedEggs[key]
				if not group then
					group = {displayName = displayName, uniqueIds = {}}
					groupedEggs[key] = group
				end
				table.insert(group.uniqueIds, uniqueId)
			end
		end

		local groups = {}
		for _, g in pairs(groupedEggs) do
			table.insert(groups, g)
		end
		table.sort(groups, function(left, right)
			return left.displayName < right.displayName
		end)

		for groupIndex, group in ipairs(groups) do
			local button = Instance.new("TextButton")
			button.Name = group.displayName
			button.Parent = list
			button.LayoutOrder = groupIndex
			button.Size = UDim2.new(1, -6, 0, 32)
			button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			button.BorderSizePixel = 0
			button.Font = Enum.Font.SourceSansBold
			button.Text = string.format("%s ×%d", group.displayName, #group.uniqueIds)
			button.TextColor3 = Color3.new(1, 1, 1)
			button.TextSize = 16
			button.TextXAlignment = Enum.TextXAlignment.Center
			button.AutoButtonColor = true
			Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

			button.Activated:Connect(function()
				if selectedGroups[group] then
					selectedGroups[group] = nil
					button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
					print("Deselected egg:", button.Text)
				else
					selectedGroups[group] = true
					button.BackgroundColor3 = Color3.fromRGB(158, 0, 158)
					print("Selected egg:", button.Text)
				end
				syncSelectedEggs()
			end)
		end
	end

	refreshButton.Activated:Connect(refreshEggs)
	refreshEggs()
end
coroutine.wrap(UHZC_fake_script)()

