local function PZSESN_fake_script() -- userInterface.Userscript 
	local script = Instance.new('LocalScript', userInterface)

	local Players = game:GetService("Players")
	local panel = script.Parent
	
	local playerList = Instance.new("ScrollingFrame")
	playerList.Name = "PlayerList"
	playerList.Parent = panel
	playerList.BackgroundTransparency = 1
	playerList.BorderSizePixel = 0
	playerList.Position = UDim2.fromOffset(8, 8)
	playerList.Size = UDim2.new(1, -16, 1, -16)
	playerList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	playerList.CanvasSize = UDim2.new()
	playerList.ScrollBarThickness = 6
	
	local layout = Instance.new("UIListLayout")
	layout.Parent = playerList
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.Name
	
	local selectedPlayer
	local tradeLoopRunning = false
	local scrollingFrame = panel.Parent
	local sendTradeButton = scrollingFrame:WaitForChild("SendTrade/Button")
	local stopTradeButton = scrollingFrame:WaitForChild("StopTrade/Button")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local API = ReplicatedStorage:WaitForChild("API")
	local addItemRemote = API:WaitForChild("TradeAPI/AddItemToOffer")
	local sendTradeRemote = ReplicatedStorage:FindFirstChild("TradeAPI/SendTradeRequest", true)
	local AcceptNeg = API:WaitForChild("TradeAPI/AcceptNegotiation")
	local ConfirmTrade = API:WaitForChild("TradeAPI/ConfirmTrade")
	local petInterface = scrollingFrame:WaitForChild("PetInterface")
	local selectedPets = petInterface:WaitForChild("SelectedPets")

	local function stopTradeLoop()
		tradeLoopRunning = false
	end

	local function startTradeLoop()
		if tradeLoopRunning then
			return
		end

		if not sendTradeRemote or not sendTradeRemote:IsA("RemoteEvent") then
			warn("TradeAPI/SendTradeRequest was not found")
			return
		end

		if not selectedPlayer then
			warn("Select a player before starting the trade loop")
			return
		end

		tradeLoopRunning = true
		task.spawn(function()
			while tradeLoopRunning do
				local targetPlayer = selectedPlayer
				if not targetPlayer or targetPlayer.Parent ~= Players then
					stopTradeLoop()
					break
				end

				pcall(function()
					sendTradeRemote:FireServer(targetPlayer)
				end)

				task.wait(2)
				for _, petId in ipairs(selectedPets:GetChildren()) do
					pcall(function()
						addItemRemote:FireServer(petId.Value)
					end)
				end

				pcall(function()
					AcceptNeg:FireServer()
					ConfirmTrade:FireServer()
				end)

				task.wait(1)
			end
		end)
	end

	sendTradeButton.Activated:Connect(startTradeLoop)
	stopTradeButton.Activated:Connect(stopTradeLoop)
	
	local function addPlayer(player)
		if player == Players.LocalPlayer then
			return
		end

		local button = Instance.new("TextButton")
		button.Name = tostring(player.UserId)
		button.Parent = playerList
		button.Size = UDim2.new(1, -6, 0, 32)
		button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		button.BorderSizePixel = 0
		button.Font = Enum.Font.SourceSansBold
		button.Text = player.Name
		button.TextColor3 = Color3.new(1, 1, 1)
		button.TextSize = 17
	
		Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)
	
		button.Activated:Connect(function()
			selectedPlayer = player
	
			for _, item in playerList:GetChildren() do
				if item:IsA("TextButton") then
					item.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
				end
			end
	
			button.BackgroundColor3 = Color3.fromRGB(158, 0, 158)
			print("Selected player:", selectedPlayer.Name)
		end)
	end
	
	for _, player in Players:GetPlayers() do
		addPlayer(player)
	end
	
	Players.PlayerAdded:Connect(addPlayer)
	
	Players.PlayerRemoving:Connect(function(player)
		local button = playerList:FindFirstChild(tostring(player.UserId))
		if button then
			button:Destroy()
		end
	
		if selectedPlayer == player then
			selectedPlayer = nil
		end
	end)
end
coroutine.wrap(PZSESN_fake_script)()

local function ZEQSNX_fake_script() -- SwitchButton.SwitchScript 
	local script = Instance.new('LocalScript', SwitchButton)

	local button = script.Parent
	local circle = button:WaitForChild("Circle")
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local API = ReplicatedStorage:WaitForChild("API")
	local tradeFunction = API:WaitForChild("TradeAPI/AcceptOrDeclineTradeRequest")
	local acceptNegotiation = API:WaitForChild("TradeAPI/AcceptNegotiation")
	local confirmTrade = API:WaitForChild("TradeAPI/ConfirmTrade")
	local autoAcceptEnabled = false
	local runId = 0

	framesToHide = {Dialog = true}

	circle.Position = UDim2.new(0, 0, 0.012, 0)
	circle.BackgroundColor3 = Color3.fromRGB(132, 0, 132)

	button.Activated:Connect(function()
		autoAcceptEnabled = not autoAcceptEnabled
		runId += 1
		local currentRunId = runId

		if autoAcceptEnabled then
			circle.Position = UDim2.new(0.47, 0, 0.012, 0)
			circle.BackgroundColor3 = Color3.fromRGB(255, 0, 255)

			task.spawn(function()
				while autoAcceptEnabled and currentRunId == runId do
					for _, targetPlayer in ipairs(Players:GetPlayers()) do
						if not autoAcceptEnabled or currentRunId ~= runId then
							break
						end

						if targetPlayer ~= Players.LocalPlayer then
							pcall(function()
								tradeFunction:InvokeServer(targetPlayer, true)
							end)
						end
					end

					pcall(function()
						acceptNegotiation:FireServer()
						confirmTrade:FireServer()
					end)
					task.wait(1)
				end
			end)

		task.spawn(function()
			while autoAcceptEnabled and currentRunId == runId do
				for _, gui in ipairs(PlayerGui:GetDescendants()) do
					if gui:IsA("Frame") and framesToHide[gui.Name] and gui.Visible then
						gui.Visible = false
						print("Successfully hid frame: " .. gui:GetFullName())
					end
				end

				task.wait(2)
			end
		end)
		else
			circle.Position = UDim2.new(0, 0, 0.012, 0)
			circle.BackgroundColor3 = Color3.fromRGB(132, 0, 132)
		end
	end)
end
coroutine.wrap(ZEQSNX_fake_script)()

