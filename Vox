local function PLAYER_LIST_fake_script()
	local script = Instance.new("LocalScript", userInterface)
	local Players = game:GetService("Players")
	local panel = script.Parent
	local main = panel:FindFirstAncestor("Main")
	local playerList = Instance.new("ScrollingFrame")
	playerList.Name = "PlayerList"
	playerList.Parent = panel
	playerList.BackgroundTransparency = 1
	playerList.BorderSizePixel = 0
	playerList.Position = UDim2.fromOffset(8, 8)
	playerList.Size = UDim2.new(1, -16, 1, -16)
	playerList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	playerList.CanvasSize = UDim2.new()
	playerList.ScrollBarThickness = 6

	local layout = Instance.new("UIListLayout", playerList)
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.Name

	local function addPlayer(player)
		if player == Players.LocalPlayer or playerList:FindFirstChild(tostring(player.UserId)) then
			return
		end

		local button = Instance.new("TextButton")
		button.Name = tostring(player.UserId)
		button.Parent = playerList
		button.Size = UDim2.new(1, -6, 0, 32)
		button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		button.BorderSizePixel = 0
		button.Font = Enum.Font.SourceSansBold
		button.Text = player.Name
		button.TextColor3 = Color3.new(1, 1, 1)
		button.TextSize = 17
		Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

		button.Activated:Connect(function()
			main:SetAttribute("SelectedTradePlayerUserId", player.UserId)
			for _, item in playerList:GetChildren() do
				if item:IsA("TextButton") then
					item.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
				end
			end
			button.BackgroundColor3 = Color3.fromRGB(158, 0, 158)
		end)
	end

	for _, player in Players:GetPlayers() do
		addPlayer(player)
	end
	Players.PlayerAdded:Connect(addPlayer)
	Players.PlayerRemoving:Connect(function(player)
		local button = playerList:FindFirstChild(tostring(player.UserId))
		if button then
			button:Destroy()
		end
		if main:GetAttribute("SelectedTradePlayerUserId") == player.UserId then
			main:SetAttribute("SelectedTradePlayerUserId", nil)
		end
	end)
end
coroutine.wrap(PLAYER_LIST_fake_script)()

local function INVENTORY_LIST_fake_script(panel, inventoryName, attributeName, emptyText)
	local script = Instance.new("LocalScript", panel)
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local LocalPlayer = game:GetService("Players").LocalPlayer
	local main = panel:FindFirstAncestor("Main")
	local list = Instance.new("ScrollingFrame")
	list.Name = inventoryName .. "List"
	list.Parent = panel
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(8, 8)
	list.Size = UDim2.new(1, -16, 1, -16)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.ScrollBarThickness = 6
	local layout = Instance.new("UIListLayout", list)
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.Name

	local ok, ClientData = pcall(function()
		return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("Core"):WaitForChild("ClientData"))
	end)

	local function refresh()
		for _, child in list:GetChildren() do
			if child:IsA("TextButton") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		if not ok or not ClientData then
			return
		end
		local dataOk, dataStore = pcall(function()
			return ClientData.get_data()
		end)
		if not dataOk then
			return
		end
		local playerData = dataStore and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])
		local inventory = playerData and playerData.inventory and playerData.inventory[inventoryName]
		local entries = {}
		if inventory then
			for uniqueId, itemData in pairs(inventory) do
				if itemData and itemData.kind then
					table.insert(entries, {id = tostring(uniqueId), data = itemData})
				end
			end
		end
		table.sort(entries, function(a, b)
			return tostring(a.data.kind) < tostring(b.data.kind)
		end)
		if #entries == 0 then
			local label = Instance.new("TextLabel")
			label.Name = "Empty"
			label.Parent = list
			label.Size = UDim2.new(1, -6, 0, 32)
			label.BackgroundTransparency = 1
			label.Text = emptyText
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextSize = 16
			return
		end
		for _, entry in ipairs(entries) do
			local button = Instance.new("TextButton")
			button.Name = entry.id
			button.Parent = list
			button.Size = UDim2.new(1, -6, 0, 32)
			button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			button.BorderSizePixel = 0
			button.Font = Enum.Font.SourceSansBold
			button.Text = tostring(entry.data.kind)
			button.TextColor3 = Color3.new(1, 1, 1)
			button.TextSize = 17
			Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)
			button.Activated:Connect(function()
				main:SetAttribute(attributeName, entry.id)
				if attributeName == "SelectedTradePetId" then
					main:SetAttribute("SelectedTradeEggId", nil)
				else
					main:SetAttribute("SelectedTradePetId", nil)
				end
				for _, item in list:GetChildren() do
					if item:IsA("TextButton") then
						item.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
					end
				end
				button.BackgroundColor3 = Color3.fromRGB(158, 0, 158)
			end)
		end
	end

	refresh()
	task.delay(1, refresh)
	panel:GetPropertyChangedSignal("Visible"):Connect(function()
		if panel.Visible then
			refresh()
		end
	end)
end
INVENTORY_LIST_fake_script(PetInterface, "pets", "SelectedTradePetId", "No pets found")
