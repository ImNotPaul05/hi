local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local Config = {
    Pet = "summer_2026_storm_condor",
    PetForm = "normal", -- "normal" or "neon"
    Food = "Age-Up Potion",
    FeedDelay = 0.5,
}

--------------------------------------------------
-- AGE LISTS
--------------------------------------------------

local NormalAges = {
    "Newborn",
    "Junior",
    "Pre-Teen",
    "Teen",
    "Post-Teen",
    "Full Grown",
}

local NeonAges = {
    "Reborn",
    "Twinkle",
    "Sparkle",
    "Flare",
    "Sunshine",
    "Luminous",
}

--------------------------------------------------
-- LOAD CLIENT DATA
--------------------------------------------------

local successClientData, ClientData = pcall(function()
    return require(
        ReplicatedStorage
            :WaitForChild("ClientModules")
            :WaitForChild("Core")
            :WaitForChild("ClientData")
    )
end)

if not successClientData or not ClientData then
    warn("Failed to load ClientData")
    return
end

print("ClientData loaded:", ClientData)

--------------------------------------------------
-- GET PLAYER DATA
--------------------------------------------------

local function GetPlayerData()
    local dataStore = ClientData.get_data()

    if not dataStore then
        return nil
    end

    return dataStore[LocalPlayer]
        or dataStore[LocalPlayer.Name]
end

--------------------------------------------------
-- GET MATCHING PETS
--------------------------------------------------

local function GetMatchingPets()

    local playerData = GetPlayerData()

    if not playerData
        or not playerData.inventory
        or not playerData.inventory.pets then

        warn("Could not find pet inventory")
        return {}
    end

    local pets = {}

    for uniqueId, itemData in pairs(playerData.inventory.pets) do

        if itemData
            and itemData.kind == Config.Pet then

            local properties = itemData.properties or {}

            local isNeon = properties.neon == true
            local isMega = properties.mega_neon == true

            --------------------------------------------------
            -- NORMAL
            --------------------------------------------------

            if Config.PetForm == "normal" then

                if not isNeon and not isMega then
                    table.insert(pets, uniqueId)
                end

            --------------------------------------------------
            -- NEON
            --------------------------------------------------

            elseif Config.PetForm == "neon" then

                if isNeon and not isMega then
                    table.insert(pets, uniqueId)
                end
            end
        end
    end

    return pets
end

--------------------------------------------------
-- EQUIP ITEM
--------------------------------------------------

local function EquipItem(uniqueId)

    if not uniqueId then
        return false
    end

    local args = {
        uniqueId,
        {
            use_sound_delay = false,
            equip_as_last = false
        }
    }

    local success, result = pcall(function()

        return ReplicatedStorage
            :WaitForChild("API")
            :WaitForChild("ToolAPI/Equip")
            :InvokeServer(unpack(args))

    end)

    if not success then
        warn("Equip failed:", result)
        return false
    end

    return true
end

--------------------------------------------------
-- GET CURRENT AGE
--------------------------------------------------

local function GetCurrentAge()

    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")

    if not PlayerGui then
        return nil
    end

    local BackpackApp = PlayerGui:FindFirstChild("BackpackApp")

    if not BackpackApp then
        return nil
    end

    --------------------------------------------------
    -- SELECT AGE LIST
    --------------------------------------------------

    local ageList

    if Config.PetForm == "normal" then
        ageList = NormalAges
    else
        ageList = NeonAges
    end

    --------------------------------------------------
    -- FIND AGE CONTAINER
    --------------------------------------------------

    local AgeContainer = BackpackApp:FindFirstChild("Age", true)

    if not AgeContainer then
        return nil
    end

    --------------------------------------------------
    -- FIND VISIBLE CURRENT AGE
    --------------------------------------------------

    for _, ageName in ipairs(ageList) do

        for _, object in ipairs(AgeContainer:GetDescendants()) do

            if object.Name == ageName then

                if object:IsA("GuiObject") then

                    if object.Visible then
                        return ageName
                    end

                else
                    return ageName
                end
            end
        end
    end

    return nil
end

--------------------------------------------------
-- DEBUG CURRENT AGE
--------------------------------------------------

local function WaitForCurrentAge()

    for i = 1, 20 do

        local age = GetCurrentAge()

        if age then
            return age
        end

        task.wait(0.1)
    end

    return nil
end

--------------------------------------------------
-- FIND AGE-UP POTION
--------------------------------------------------

local function FindAgeUpPotion()

    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")

    if not PlayerGui then
        return nil
    end

    local BackpackApp = PlayerGui:FindFirstChild("BackpackApp")

    if not BackpackApp then
        return nil
    end

    local Food = BackpackApp:FindFirstChild("Food", true)

    if not Food then
        return nil
    end

    --------------------------------------------------
    -- LOOK FOR AGE-UP POTION IMAGE
    --------------------------------------------------

    for _, object in ipairs(Food:GetDescendants()) do

        if object.Name == "Button"
            and object:IsA("ImageButton") then

            if object.Image == "rbxassetid://2577318741" then

                --------------------------------------------------
                -- RETURN THE 2_xxx FOOD UNIQUE ID
                --------------------------------------------------

                local parent = object.Parent

                if parent then

                    local foodObject = parent

                    while foodObject
                        and foodObject ~= Food do

                        if string.sub(foodObject.Name, 1, 2) == "2_" then
                            return foodObject.Name
                        end

                        foodObject = foodObject.Parent
                    end
                end
            end
        end
    end

    return nil
end

--------------------------------------------------
-- CREATE PET OBJECT
--------------------------------------------------

local function CreatePetObject(petUniqueId)

    local character = LocalPlayer.Character

    if not character then
        return false
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root then
        return false
    end

    local objectUniqueId =
        "2_" .. HttpService:GenerateGUID(false):gsub("-", "")

    local args = {
        "__Enum_PetObjectCreatorType_2",
        {
            pet_unique = petUniqueId,
            spawn_cframe = root.CFrame,
            additional_consume_uniques = {},
            unique_id = objectUniqueId
        }
    }

    local success, result = pcall(function()

        return ReplicatedStorage
            :WaitForChild("API")
            :WaitForChild("PetObjectAPI/CreatePetObject")
            :InvokeServer(unpack(args))

    end)

    if not success then
        warn("CreatePetObject failed:", result)
        return false
    end

    return true
end

--------------------------------------------------
-- CONSUME FOOD
--------------------------------------------------

local function ConsumeFood(foodUniqueId)

    if not foodUniqueId then
        return false
    end

    local args = {
        Instance.new("Model", nil),
        foodUniqueId
    }

    local success, result = pcall(function()

        ReplicatedStorage
            :WaitForChild("API")
            :WaitForChild("PetAPI/ConsumeFoodObject")
            :FireServer(unpack(args))

    end)

    if not success then
        warn("ConsumeFood failed:", result)
        return false
    end

    return true
end

--------------------------------------------------
-- CHECK IF MAX AGE
--------------------------------------------------

local function IsMaxAge(age)

    if Config.PetForm == "normal" then
        return age == "Full Grown"
    end

    if Config.PetForm == "neon" then
        return age == "Luminous"
    end

    return false
end

--------------------------------------------------
-- AGE ONE PET
--------------------------------------------------

local function AgePet(petUniqueId, petNumber)

    print("")
    print("========================================")
    print("PET", petNumber)
    print("Unique ID:", petUniqueId)
    print("========================================")

    --------------------------------------------------
    -- EQUIP TARGET PET
    --------------------------------------------------

    print("Equipping pet...")

    if not EquipItem(petUniqueId) then
        warn("Failed to equip pet")
        return false
    end

    task.wait(0.5)

    --------------------------------------------------
    -- READ CURRENT AGE
    --------------------------------------------------

    local currentAge = WaitForCurrentAge()

    if not currentAge then
        warn("Could not determine current age")
        return false
    end

    print("Current age:", currentAge)

    --------------------------------------------------
    -- ALREADY MAX AGE
    --------------------------------------------------

    if IsMaxAge(currentAge) then

        print("Pet is already max age.")
        print("Skipping pet.")

        return true
    end

    --------------------------------------------------
    -- KEEP AGING
    --------------------------------------------------

    while true do

        --------------------------------------------------
        -- FIND POTION
        --------------------------------------------------

        local potionUniqueId = FindAgeUpPotion()

        if not potionUniqueId then

            warn("No Age-Up Potion remaining.")

            return false
        end

        print("Age-Up Potion:", potionUniqueId)

        --------------------------------------------------
        -- EQUIP POTION
        --------------------------------------------------

        print("Equipping Age-Up Potion...")

        if not EquipItem(potionUniqueId) then

            warn("Failed to equip Age-Up Potion.")

            return false
        end

        task.wait(0.2)

        --------------------------------------------------
        -- CREATE PET OBJECT
        --------------------------------------------------

        print("Creating pet object...")

        if not CreatePetObject(petUniqueId) then

            warn("Failed to create pet object.")

            return false
        end

        task.wait(0.2)

        --------------------------------------------------
        -- CONSUME POTION
        --------------------------------------------------

        print("Consuming Age-Up Potion...")

        if not ConsumeFood(potionUniqueId) then

            warn("Failed to consume Age-Up Potion.")

            return false
        end

        task.wait(Config.FeedDelay)

        --------------------------------------------------
        -- RE-EQUIP THE SAME PET
        --
        -- This is important because we want BackpackApp
        -- to show THIS pet's age again.
        --------------------------------------------------

        print("Re-equipping pet to check age...")

        if not EquipItem(petUniqueId) then

            warn("Failed to re-equip pet.")

            return false
        end

        task.wait(0.5)

        --------------------------------------------------
        -- READ NEW AGE
        --------------------------------------------------

        currentAge = WaitForCurrentAge()

        if not currentAge then

            warn("Could not determine pet age after potion.")

            return false
        end

        print("New age:", currentAge)

        --------------------------------------------------
        -- MAX AGE?
        --------------------------------------------------

        if IsMaxAge(currentAge) then

            print("Pet reached maximum age!")

            return true
        end

        --------------------------------------------------
        -- CONTINUE
        --------------------------------------------------

        print("Pet is not max age yet.")
        print("Using another Age-Up Potion...")

    end
end

--------------------------------------------------
-- MAIN
--------------------------------------------------

print("")
print("========================================")
print("AUTO AGE STARTED")
print("Pet:", Config.Pet)
print("Form:", Config.PetForm)
print("Food:", Config.Food)
print("========================================")

--------------------------------------------------
-- GET PETS
--------------------------------------------------

local pets = GetMatchingPets()

print("Matching pets found:", #pets)

if #pets == 0 then

    warn("No matching pets found:", Config.Pet)

    return
end

--------------------------------------------------
-- PROCESS PETS
--------------------------------------------------

for index, petUniqueId in ipairs(pets) do

    local success = AgePet(
        petUniqueId,
        index
    )

    --------------------------------------------------
    -- NO POTIONS
    --------------------------------------------------

    if not success then

        warn("Stopped because the current pet could not be processed.")

        break
    end

    task.wait(0.5)
end

print("")
print("========================================")
print("AUTO AGE FINISHED")
print("========================================")
