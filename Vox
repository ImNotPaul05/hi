local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local Config = {
    Pet = "summer_2026_storm_condor", -- Pet kind / ID
    PetForm = "normal",                -- "normal" or "neon"

    -- Maximum number of Age-Up Potions sent in one batch.
    MaxPotionBatch = 15,

    FeedDelay = 0.5,
}

--==================================================
-- CLIENT DATA
--==================================================

local successClientData, ClientData = pcall(function()
    return require(
        ReplicatedStorage
            :WaitForChild("ClientModules")
            :WaitForChild("Core")
            :WaitForChild("ClientData")
    )
end)

if not successClientData or not ClientData then
    error("Failed to load ClientData")
end

--==================================================
-- GET PLAYER DATA
--==================================================

local function GetPlayerData()
    local dataStore = ClientData.get_data()

    if not dataStore then
        return nil
    end

    return dataStore[LocalPlayer]
        or dataStore[LocalPlayer.Name]
end

--==================================================
-- GET MATCHING PETS
--==================================================

local function GetMatchingPets()
    local playerData = GetPlayerData()

    if not playerData
        or not playerData.inventory
        or not playerData.inventory.pets then
        return {}
    end

    local uniqueIds = {}

    local wantedKind = Config.Pet
    local wantedForm = string.lower(Config.PetForm)

    for uniqueId, itemData in pairs(playerData.inventory.pets) do
        if itemData and itemData.kind == wantedKind then
            local properties = itemData.properties or {}

            local isNeon = properties.neon == true
            local isMegaNeon = properties.mega_neon == true

            local matchesForm =
                (
                    wantedForm == "neon"
                    and isNeon
                    and not isMegaNeon
                )
                or
                (
                    wantedForm == "normal"
                    and not isNeon
                    and not isMegaNeon
                )

            if matchesForm then
                table.insert(uniqueIds, uniqueId)
            end
        end
    end

    return uniqueIds
end

--==================================================
-- EQUIP ITEM
--==================================================

local function EquipItem(uniqueId)
    local args = {
        uniqueId,
        {
            use_sound_delay = false,
            equip_as_last = false
        }
    }

    local success, result = pcall(function()
        return ReplicatedStorage
            :WaitForChild("API")
            :WaitForChild("ToolAPI/Equip")
            :InvokeServer(unpack(args))
    end)

    if not success then
        warn("Equip failed:", result)
        return false
    end

    return true
end

--==================================================
-- GET CURRENT PET AGE
--==================================================

local function GetCurrentAge()
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")

    if not PlayerGui then
        return nil
    end

    local BackpackApp = PlayerGui:FindFirstChild("BackpackApp")

    if not BackpackApp then
        return nil
    end

    -- Exact path:
    --
    -- BackpackApp
    --   Frame
    --     Filter
    --       Content
    --         ScrollComplex
    --           ScrollingFrame
    --             Content
    --               Age
    --                 Container
    --                   Content

    local Frame = BackpackApp:FindFirstChild("Frame")
    if not Frame then
        return nil
    end

    local Filter = Frame:FindFirstChild("Filter")
    if not Filter then
        return nil
    end

    local MainContent = Filter:FindFirstChild("Content")
    if not MainContent then
        return nil
    end

    local ScrollComplex = MainContent:FindFirstChild("ScrollComplex")
    if not ScrollComplex then
        return nil
    end

    local ScrollingFrame = ScrollComplex:FindFirstChild("ScrollingFrame")
    if not ScrollingFrame then
        return nil
    end

    local ScrollContent = ScrollingFrame:FindFirstChild("Content")
    if not ScrollContent then
        return nil
    end

    local Age = ScrollContent:FindFirstChild("Age")
    if not Age then
        return nil
    end

    local Container = Age:FindFirstChild("Container")
    if not Container then
        return nil
    end

    local Content = Container:FindFirstChild("Content")
    if not Content then
        return nil
    end

    local ageList

    if string.lower(Config.PetForm) == "neon" then
        ageList = {
            "Reborn",
            "Twinkle",
            "Sparkle",
            "Flare",
            "Sunshine",
            "Luminous"
        }
    else
        ageList = {
            "Newborn",
            "Junior",
            "Pre-Teen",
            "Teen",
            "Post-Teen",
            "Full Grown"
        }
    end

    -- Only accept visible age objects.
    for _, ageName in ipairs(ageList) do
        local ageObject = Content:FindFirstChild(ageName, true)

        if ageObject and ageObject:IsA("GuiObject") then
            if ageObject.Visible then
                return ageName
            end
        end
    end

    return nil
end

--==================================================
-- WAIT FOR AGE UI
--==================================================

local function WaitForCurrentAge(timeout)
    timeout = timeout or 5

    local startTime = tick()

    while tick() - startTime < timeout do
        local age = GetCurrentAge()

        if age then
            return age
        end

        task.wait(0.15)
    end

    return nil
end

--==================================================
-- MAX AGE CHECK
--==================================================

local function IsMaxAge(age)
    if string.lower(Config.PetForm) == "neon" then
        return age == "Luminous"
    end

    return age == "Full Grown"
end

--==================================================
-- GET AGE-UP POTIONS
--==================================================

local function GetAgeUpPotions(maxAmount)
    local playerData = GetPlayerData()

    if not playerData
        or not playerData.inventory
        or not playerData.inventory.food then
        return {}
    end

    local potionIds = {}

    for uniqueId, itemData in pairs(playerData.inventory.food) do
        if itemData and itemData.kind == "pet_age_potion" then
            table.insert(potionIds, uniqueId)

            if #potionIds >= maxAmount then
                break
            end
        end
    end

    return potionIds
end

--==================================================
-- USE AGE-UP POTIONS
--==================================================

local function UseAgeUpPotions(petUniqueId)
    local potionIds = GetAgeUpPotions(Config.MaxPotionBatch)

    if #potionIds == 0 then
        warn("No Age-Up Potions available.")
        return false
    end

    print("--------------------------------")
    print("Potion batch size:", #potionIds)

    for i, potionId in ipairs(potionIds) do
        print("Potion", i, ":", potionId)
    end

    local firstPotionId = potionIds[1]

    local additionalPotions = {}

    for i = 2, #potionIds do
        table.insert(additionalPotions, potionIds[i])
    end

    --==================================================
    -- START AGE-UP POTION
    --==================================================

    local startSuccess, startResult = pcall(function()
        return ReplicatedStorage
            :WaitForChild("API")
            :WaitForChild("ToolAPI/ServerUseTool")
            :InvokeServer(
                firstPotionId,
                "START"
            )
    end)

    if not startSuccess then
        warn("ServerUseTool failed:", startResult)
        return false
    end

    task.wait(0.2)

    --==================================================
    -- CREATE PET OBJECT
    --==================================================

    local createSuccess, createResult = pcall(function()
        local args = {
            "__Enum_PetObjectCreatorType_2",
            {
                additional_consume_uniques = additionalPotions,

                pet_unique = petUniqueId,

                -- Kept consistent with the captured
                -- one-potion request.
                unique_id = firstPotionId
            }
        }

        return ReplicatedStorage
            :WaitForChild("API")
            :WaitForChild("PetObjectAPI/CreatePetObject")
            :InvokeServer(unpack(args))
    end)

    if not createSuccess then
        warn("CreatePetObject failed:", createResult)
        return false
    end

    return true
end

--==================================================
-- AGE ONE PET
--==================================================

local function AgePet(petUniqueId)
    print("")
    print("================================")
    print("Processing pet:", petUniqueId)

    --==================================================
    -- EQUIP PET
    --==================================================

    if not EquipItem(petUniqueId) then
        warn("Failed to equip pet:", petUniqueId)
        return false
    end

    -- IMPORTANT:
    -- Wait for BackpackApp to update to the newly
    -- equipped pet before reading its age.
    task.wait(1)

    --==================================================
    -- READ AGE
    --==================================================

    local age = WaitForCurrentAge(5)

    if not age then
        warn("Could not determine age for:", petUniqueId)
        return false
    end

    print("Current age:", age)

    --==================================================
    -- ALREADY MAX?
    --==================================================

    if IsMaxAge(age) then
        print("Already max age. Skipping:", petUniqueId)
        return true
    end

    --==================================================
    -- KEEP AGING UNTIL MAX
    --==================================================

    while not IsMaxAge(age) do

        print("--------------------------------")
        print("Pet:", petUniqueId)
        print("Age before batch:", age)
        print("Using up to", Config.MaxPotionBatch, "potions...")

        local success = UseAgeUpPotions(petUniqueId)

        if not success then
            warn("Unable to use Age-Up Potion(s).")
            return false
        end

        -- Give the server/UI time to update.
        task.wait(1)

        --==================================================
        -- RE-EQUIP SAME PET
        --==================================================

        if not EquipItem(petUniqueId) then
            warn("Failed to re-equip:", petUniqueId)
            return false
        end

        -- Wait for BackpackApp to refresh.
        task.wait(0.75)

        --==================================================
        -- READ UPDATED AGE
        --==================================================

        local newAge = WaitForCurrentAge(5)

        if not newAge then
            warn("Could not read updated age.")
            return false
        end

        age = newAge

        print("Age after batch:", age)

        --==================================================
        -- MAX AGE?
        --==================================================

        if IsMaxAge(age) then
            print("Reached max age:", petUniqueId)
            break
        end

        task.wait(Config.FeedDelay)
    end

    return true
end

--==================================================
-- MAIN
--==================================================

print("")
print("================================")
print("AUTO PET AGING STARTED")
print("================================")
print("Pet:", Config.Pet)
print("Form:", Config.PetForm)
print("Max potion batch:", Config.MaxPotionBatch)
print("================================")

--==================================================
-- FIND ALL MATCHING PETS
--==================================================

local pets = GetMatchingPets()

print("Matching pets found:", #pets)

if #pets == 0 then
    warn("No matching pets found.")
    return
end

--==================================================
-- PROCESS EVERY PET
--==================================================

for index, petUniqueId in ipairs(pets) do

    print("")
    print("================================")
    print("PET", index, "OF", #pets)
    print("Unique ID:", petUniqueId)
    print("================================")

    local success = AgePet(petUniqueId)

    if not success then
        warn("Stopped processing because feeding failed.")
        break
    end

    task.wait(0.5)
end

--==================================================
-- FINISHED
--==================================================

print("")
print("================================")
print("AUTO PET AGING FINISHED")
print("================================")
