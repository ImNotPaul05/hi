local Config = {
    TargetUsername = "XzMysticbAClawnzX",
}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local target = Players:WaitForChild(Config.TargetUsername)

local furnitureId
local outfitUUID

-- Search target player's objects for possible values
for _, obj in ipairs(target:GetDescendants()) do
    -- Attributes
    for name, value in pairs(obj:GetAttributes()) do
        if typeof(value) == "string" then
            if value:match("^f%-") then
                furnitureId = furnitureId or value
            elseif value:match(
                "^[%x]+%-%x+%-%x+%-%x+%-%x+$"
            ) then
                outfitUUID = outfitUUID or value
            end
        end
    end

    -- StringValue
    if obj:IsA("StringValue") then
        local value = obj.Value

        if value:match("^f%-") then
            furnitureId = furnitureId or value
        elseif value:match(
            "^[%x]+%-%x+%-%x+%-%x+%-%x+$"
        ) then
            outfitUUID = outfitUUID or value
        end
    end
end

print("Furniture ID:", furnitureId)
print("Outfit UUID:", outfitUUID)

if not furnitureId or not outfitUUID then
    warn("Could not find the required API arguments.")
    return
end

local remote = ReplicatedStorage
    :WaitForChild("API")
    :WaitForChild("AvatarAPI/BuyMannequinOutfit")

remote:InvokeServer(
    target,
    furnitureId,
    outfitUUID,
    100
)
