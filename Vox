local function YIEDIF_fake_script() -- PetInterface.Petscript 
	local script = Instance.new('LocalScript', PetInterface)

	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local LocalPlayer = game.Players.LocalPlayer
	local panel = script.Parent
	local main = panel:FindFirstAncestor("Main")
	local refreshButton = main:FindFirstChild("RefreshPet/Button", true)
	local selectedPets = {}

	_G.SelectedPetIds = selectedPets

	local successClientData, ClientData = pcall(function()
		return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("Core"):WaitForChild("ClientData"))
	end)

	local petList = Instance.new("ScrollingFrame")
	petList.Name = "PetList"
	petList.Parent = panel
	petList.BackgroundTransparency = 1
	petList.BorderSizePixel = 0
	petList.Position = UDim2.fromOffset(8, 8)
	petList.Size = UDim2.new(1, -16, 1, -16)
	petList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	petList.CanvasSize = UDim2.new()
	petList.ScrollBarThickness = 6

	local layout = Instance.new("UIListLayout")
	layout.Parent = petList
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.Name

	local function getPetDisplayName(itemData)
		local displayName = itemData.display_name or itemData.displayName or itemData.kind or "Unknown pet"
		displayName = tostring(displayName):gsub("_", " ")
		return displayName:gsub("%S+", function(word)
			return word:gsub("^%l", string.upper)
		end)
	end

	local function getPets()
		if not successClientData or not ClientData then
			return {}
		end

		local dataStore = ClientData.get_data()
		local playerData = dataStore and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])
		return playerData and playerData.inventory and playerData.inventory.pets or {}
	end

	local function refreshPets()
		for _, child in ipairs(petList:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		local pets = getPets()
		local petEntries = {}
		for uniqueId, itemData in pairs(pets) do
			if itemData then
				table.insert(petEntries, {
					id = uniqueId,
					name = getPetDisplayName(itemData)
				})
			end
		end

		table.sort(petEntries, function(left, right)
			return left.name .. tostring(left.id) < right.name .. tostring(right.id)
		end)

		for _, pet in ipairs(petEntries) do
			local button = Instance.new("TextButton")
			button.Name = tostring(pet.id)
			button.Parent = petList
			button.Size = UDim2.new(1, -6, 0, 32)
			button.BackgroundColor3 = selectedPets[pet.id]
				and Color3.fromRGB(158, 0, 158)
				or Color3.fromRGB(45, 45, 45)
			button.BorderSizePixel = 0
			button.Font = Enum.Font.SourceSansBold
			button.Text = pet.name
			button.TextColor3 = Color3.new(1, 1, 1)
			button.TextSize = 17

			Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

			button.Activated:Connect(function()
				selectedPets[pet.id] = not selectedPets[pet.id] and true or nil
				button.BackgroundColor3 = selectedPets[pet.id]
					and Color3.fromRGB(158, 0, 158)
					or Color3.fromRGB(45, 45, 45)
			end)
		end
	end

	refreshPets()
	if refreshButton then
		refreshButton.Activated:Connect(refreshPets)
	end
end
coroutine.wrap(YIEDIF_fake_script)()
