local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- LOAD CLIENT DATA
--------------------------------------------------

local success, ClientData = pcall(function()
    return require(
        ReplicatedStorage
            :WaitForChild("ClientModules")
            :WaitForChild("Core")
            :WaitForChild("ClientData")
    )
end)

if not success or not ClientData then
    warn("Failed to load ClientData")
    return
end

--------------------------------------------------
-- GET PLAYER DATA
--------------------------------------------------

local dataStore = ClientData.get_data()

local playerData = dataStore and (
    dataStore[LocalPlayer]
    or dataStore[LocalPlayer.Name]
)

if not playerData then
    warn("No playerData")
    return
end

if not playerData.inventory then
    warn("No inventory")
    return
end

print("========== INVENTORY ==========")

for category, inventoryData in pairs(playerData.inventory) do

    print("")
    print("CATEGORY:", category)

    if type(inventoryData) == "table" then

        local count = 0

        for uniqueId, itemData in pairs(inventoryData) do

            count += 1

            if type(itemData) == "table" then

                print(
                    "  ID:",
                    uniqueId,
                    "| kind:",
                    itemData.kind,
                    "| amount:",
                    itemData.amount
                )

            else

                print(
                    "  ID:",
                    uniqueId,
                    "| value:",
                    itemData
                )

            end
        end

        print("  TOTAL:", count)

    else

        print("  VALUE:", inventoryData)

    end
end

print("")
print("========== END ==========")
