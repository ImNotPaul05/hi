		fill = Instance.new("Frame")
		fill.Name = "ClickFill"
		fill.AnchorPoint = Vector2.new(0, 0.5)
		fill.Position = UDim2.fromScale(0, 0.5)
		fill.Size = UDim2.fromScale(0, 1)
		fill.BackgroundColor3 = Color3.fromRGB(163, 0, 163)
		fill.BackgroundTransparency = 0.30
		fill.BorderSizePixel = 0
		fill.ZIndex = button.ZIndex + 1
		fill.Parent = button
	
		local corner = button:FindFirstChildOfClass("UICorner")
		if corner then
			corner:Clone().Parent = fill
		end
	end
	
	local originalTextTransparency = button:IsA("TextButton") and button.TextTransparency or nil
	local activeTween
	
	local function playClickFill()
		if activeTween then
			activeTween:Cancel()
		end
	
		fill.Size = UDim2.fromScale(0, 1)
		fill.Visible = true
		local tween = TweenService:Create(
			fill,
			TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{Size = UDim2.fromScale(1, 1)}
		)
		activeTween = tween
		tween.Completed:Once(function()
			if activeTween == tween then
				fill.Visible = false
			end
		end)
		tween:Play()
	
		if button:IsA("TextButton") then
			button.TextTransparency = 0.25
			task.delay(0.18, function()
				if button.Parent then
					button.TextTransparency = originalTextTransparency
				end
			end)
		end
	end
	
	button.Activated:Connect(playClickFill)

	button.Activated:Connect(function()
		if not _G.TradeLoopPlayerName then
			button.Text = "Select a player first"
			return
		end

		_G.TradeLoopRunning = true
		button.Text = "Sending trades"
	end)
	
end
