local function TRADE_LOOP_fake_script()
	local script = Instance.new("LocalScript", Main)
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local main = script.Parent
	local scrollingFrame = main:WaitForChild("Trading"):WaitForChild("ScrollingFrame")
	local startButton = scrollingFrame:WaitForChild("SendTrade/Button")
	local stopButton = scrollingFrame:WaitForChild("StopTrade/Button")
	local addItemRemote = ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AddItemToOffer")
	local sendTradeRemote = ReplicatedStorage:FindFirstChild("TradeAPI/SendTradeRequest", true)
	local loopToken = 0

	local function stopTradeLoop()
		loopToken += 1
	end

	startButton.Activated:Connect(function()
		local selectedUserId = main:GetAttribute("SelectedTradePlayerUserId")
		local targetPlayer = selectedUserId and Players:GetPlayerByUserId(selectedUserId)
		local selectedPetId = main:GetAttribute("SelectedTradePetId")
		local selectedEggId = main:GetAttribute("SelectedTradeEggId")
		local itemId = selectedPetId or selectedEggId

		if not targetPlayer or targetPlayer == Players.LocalPlayer then
			warn("Select another player before starting auto-trade.")
			return
		end
		if not itemId then
			warn("Select a pet or egg before starting auto-trade.")
			return
		end
		if not sendTradeRemote or not sendTradeRemote:IsA("RemoteEvent") then
			warn("TradeAPI/SendTradeRequest was not found.")
			return
		end

		stopTradeLoop()
		local currentToken = loopToken
		task.spawn(function()
			while loopToken == currentToken do
				targetPlayer = Players:GetPlayerByUserId(selectedUserId)
				if not targetPlayer or targetPlayer == Players.LocalPlayer then
					break
				end
				pcall(function()
					addItemRemote:FireServer(itemId)
					sendTradeRemote:FireServer(targetPlayer)
				end)
				task.wait(5)
			end
		end)
	end)
	stopButton.Activated:Connect(stopTradeLoop)
end
coroutine.wrap(TRADE_LOOP_fake_script)()

