-- LEGENDARY PET DISPLAY
-- Uses the same ClientData inventory source as Transfer.luau.
--==================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local function getPlayerData()
	local success, clientData = pcall(function()
		return require(
			ReplicatedStorage
				:WaitForChild("ClientModules")
				:WaitForChild("Core")
				:WaitForChild("ClientData")
		)
	end)

	if not success or not clientData then
		return nil
	end

	local dataStore = clientData.get_data()
	return dataStore and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])
end

local petDefinitions

local function getPetDefinitions()
	if petDefinitions then
		return petDefinitions
	end

	-- Different game versions use different names for this module.
	for _, moduleName in ipairs({ "PetData", "PetDatabase", "PetDefinitions" }) do
		for _, object in ipairs(ReplicatedStorage:GetDescendants()) do
			if object:IsA("ModuleScript") and object.Name == moduleName then
				local success, definitions = pcall(require, object)
				if success and type(definitions) == "table" then
					petDefinitions = definitions
					return petDefinitions
				end
			end
		end
	end
end

local function getPetDefinition(kind)
	local definitions = getPetDefinitions()
	if not definitions then
		return nil
	end

	return definitions[kind]
		or (definitions.pets and definitions.pets[kind])
end

local function toImageAsset(image)
	if type(image) == "number" then
		return "rbxassetid://" .. image
	end

	if type(image) == "string" and image ~= "" then
		if image:match("^rbxasset") or image:match("^https?://") then
			return image
		end

		if tonumber(image) then
			return "rbxassetid://" .. image
		end
	end
end

local function getPetImage(definition)
	if type(definition) ~= "table" then
		return nil
	end

	for _, key in ipairs({ "image", "icon", "thumbnail", "image_id", "asset_id" }) do
		local image = toImageAsset(definition[key])
		if image then
			return image
		end
	end
end

local function isLegendary(petData, definition)
	local rarity = petData.rarity
		or (petData.properties and petData.properties.rarity)
		or (definition and definition.rarity)

	return type(rarity) == "string" and rarity:lower() == "legendary"
end

local function refreshLegendaryPet()
	local playerData = getPlayerData()
	local pets = playerData and playerData.inventory and playerData.inventory.pets

	if not pets then
		status.Text = "Inventory unavailable"
		return
	end

	for _, petData in pairs(pets) do
		local definition = petData and getPetDefinition(petData.kind)
		if petData and isLegendary(petData, definition) then
			local image = getPetImage(definition)
			if image then
				ImageLabel.Image = image
			end

			status.Text = (definition and (definition.name or definition.display_name)) or petData.kind
			return
		end
	end

	ImageLabel.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
	status.Text = "No Legendary pet"
end

task.spawn(function()
	while Main.Parent do
		refreshLegendaryPet()
		task.wait(1)
	end
end)

