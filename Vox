--==================================================
-- EQUIP FOOD
--==================================================

local function EquipFood(foodUnique)
    if not foodUnique then
        return false
    end

    local args = {
        foodUnique,
        {
            use_sound_delay = false,
            equip_as_last = false
        }
    }

    EquipRemote:InvokeServer(unpack(args))

    return true
end

--==================================================
-- FEED PET
--==================================================

local function FeedPet(foodUnique, petUnique)
    if not foodUnique or not petUnique then
        return false
    end

    local character = Player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return false
    end

    local args = {
        "__Enum_PetObjectCreatorType_2",
        {
            pet_unique = petUnique,
            spawn_cframe = root.CFrame,
            additional_consume_uniques = {},
            unique_id = "2_" .. game:GetService("HttpService"):GenerateGUID(false)
        }
    }

    CreatePetObjectRemote:InvokeServer(unpack(args))

    task.wait(Config.FeedDelay)

    ConsumeFoodRemote:FireServer(
        Instance.new("Model"),
        foodUnique
    )

    return true
end

--==================================================
-- MAIN LOOP
--==================================================

task.spawn(function()
    while true do

        local petUnique = FindPet()

        if not petUnique then
            warn("No pet found:", Config.Pet)
            task.wait(1)
            continue
        end

        local foodUnique = FindFood()

        if not foodUnique then
            warn("No food found:", Config.Food)
            task.wait(1)
            continue
        end

        -- Equip the configured pet.
        -- The actual pet-equipping API wasn't included
        -- in the captures, so this remains game-specific.

        EquipFood(foodUnique)

        -- Feed until the Friend/max indicator appears.
        while not IsPetMaxed() do

            foodUnique = FindFood()

            if not foodUnique then
                warn("Out of", Config.Food)
                break
            end

            FeedPet(foodUnique, petUnique)

            task.wait(Config.CheckDelay)
        end

        -- Current pet reached max.
        -- Go back to FindPet(), which should return
        -- another instance of Config.Pet.

        task.wait(0.5)
    end
end)
