local function TRADINGCONTROLLER_fake_script() -- Main.TradingController
	local script = Instance.new("LocalScript", Main)

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer
	local api = ReplicatedStorage:WaitForChild("API")
	local panel = Trading:WaitForChild("ScrollingFrame")
	local playerPanel = userInterface
	local petPanel = PetInterface
	local eggPanel = EggInterface

	local sendTradeRemote = ReplicatedStorage:FindFirstChild("TradeAPI/SendTradeRequest", true)
	local addItemRemote = api:WaitForChild("TradeAPI/AddItemToOffer")
	local successClientData, ClientData = pcall(function()
		return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("Core"):WaitForChild("ClientData"))
	end)

	local selectedPlayer
	local selectedOffer
	local tradeLoopRunning = false

	local function getPlayerData()
		if not successClientData or not ClientData then
			return nil
		end

		local dataStore = ClientData.get_data()
		return dataStore and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])
	end

	local function createList(parent, name)
		local oldList = parent:FindFirstChild(name)
		if oldList then
			oldList:Destroy()
		end

		local list = Instance.new("ScrollingFrame")
		list.Name = name
		list.Parent = parent
		list.BackgroundTransparency = 1
		list.BorderSizePixel = 0
		list.Position = UDim2.fromOffset(8, 8)
		list.Size = UDim2.new(1, -16, 1, -16)
		list.AutomaticCanvasSize = Enum.AutomaticSize.Y
		list.CanvasSize = UDim2.new()
		list.ScrollBarThickness = 6

		local layout = Instance.new("UIListLayout")
		layout.Parent = list
		layout.Padding = UDim.new(0, 6)
		layout.SortOrder = Enum.SortOrder.Name
		return list
	end

	local function makeButton(list, name, text)
		local button = Instance.new("TextButton")
		button.Name = name
		button.Parent = list
		button.Size = UDim2.new(1, -6, 0, 32)
		button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		button.BorderSizePixel = 0
		button.Font = Enum.Font.SourceSansBold
		button.Text = text
		button.TextColor3 = Color3.new(1, 1, 1)
		button.TextSize = 17
		Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)
		return button
	end

	local function selectButton(list, button, color)
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			end
		end
		button.BackgroundColor3 = color or Color3.fromRGB(158, 0, 158)
	end

	local function refreshPlayers()
		local list = playerPanel:FindFirstChild("PlayerList")
		if not list then
			list = createList(playerPanel, "PlayerList")
		else
			for _, child in ipairs(list:GetChildren()) do
				if child:IsA("TextButton") then
					child:Destroy()
				end
			end
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local button = makeButton(list, tostring(player.UserId), player.Name)
				button.Activated:Connect(function()
					selectedPlayer = player
					selectButton(list, button)
					print("Selected player:", player.Name)
				end)
			end
		end
	end

	local function getInventory(kind)
		local playerData = getPlayerData()
		local inventory = playerData and playerData.inventory and playerData.inventory[kind]
		local grouped = {}
		if type(inventory) ~= "table" then
			return grouped
		end

		for uniqueId, itemData in pairs(inventory) do
			if type(itemData) == "table" then
				local itemName = itemData.kind or itemData.name or itemData.id or "Unknown"
				local group = grouped[itemName]
				if not group then
					group = {name = tostring(itemName), ids = {}}
					grouped[itemName] = group
				end
				table.insert(group.ids, uniqueId)
			end
		end
		return grouped
	end

	local function refreshInventory(kind, parent, selectedName)
		local oldPlayerList = parent:FindFirstChild("PlayerList")
		if oldPlayerList then
			oldPlayerList:Destroy()
		end
		local listName = kind == "pets" and "PetInventoryList" or "EggInventoryList"
		local list = createList(parent, listName)
		local groups = getInventory(kind)
		local names = {}
		for name in pairs(groups) do
			table.insert(names, name)
		end
		table.sort(names)

		for _, name in ipairs(names) do
			local group = groups[name]
			local button = makeButton(list, name, string.format("%s x%d", group.name, #group.ids))
			button.Activated:Connect(function()
				selectButton(list, button)
				selectedOffer = group
				print("Selected " .. selectedName .. ":", group.name, #group.ids)
			end)
		end
	end

	local function addSelectedItems()
		local selected = selectedOffer
		if not selected then
			return
		end

		for index, uniqueId in ipairs(selected.ids) do
			if index > 18 then
				break
			end
			pcall(function()
				addItemRemote:FireServer(uniqueId)
			end)
			task.wait(0.05)
		end
	end

	local function sendTradeRequest()
		if not selectedPlayer or not selectedPlayer.Parent or not sendTradeRemote then
			return
		end
		if sendTradeRemote:IsA("RemoteEvent") then
			pcall(function()
				sendTradeRemote:FireServer(selectedPlayer)
			end)
		end
	end

	local function stopTradeLoop()
		tradeLoopRunning = false
		SendTradeButton.Text = "Start auto-trade"
	end

	local function startTradeLoop()
		if tradeLoopRunning then
			return
		end
		if not selectedPlayer then
			warn("Select a player first")
			return
		end

		tradeLoopRunning = true
		SendTradeButton.Text = "Auto-trade running"
		task.spawn(function()
			while tradeLoopRunning do
				addSelectedItems()
				sendTradeRequest()
				task.wait(5)
			end
		end)
	end

	refreshPlayers()
	refreshInventory("pets", PetInterface, "pet")
	refreshInventory("eggs", EggInterface, "egg")

	RefreshPlrButton.Activated:Connect(refreshPlayers)
	RefreshPetButton.Activated:Connect(function()
		refreshInventory("pets", PetInterface, "pet")
	end)
	RefreshEggButton.Activated:Connect(function()
		refreshInventory("eggs", EggInterface, "egg")
	end)
	SendTradeButton.Activated:Connect(startTradeLoop)
	StopTradeButton.Activated:Connect(stopTradeLoop)
	Players.PlayerRemoving:Connect(function(player)
		if selectedPlayer == player then
			selectedPlayer = nil
			stopTradeLoop()
		end
		refreshPlayers()
	end)
end
coroutine.wrap(TRADINGCONTROLLER_fake_script)()
