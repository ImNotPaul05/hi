local function BLRVIFE_fake_script() -- ScrollingFrame.LocalScript 
	local script = Instance.new('LocalScript', ScrollingFrame)

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer
	
	local successClientData, ClientData = pcall(function()
		return require(
			ReplicatedStorage
				:WaitForChild("ClientModules")
				:WaitForChild("Core")
				:WaitForChild("ClientData")
		)
	end)
	
	local function getPlayerData()
		if not successClientData or not ClientData then
			return nil
		end
	
		local dataStore = ClientData.get_data()
		return dataStore and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])
	end
	
	local function isLegendary(value)
		return string.find(string.lower(tostring(value or "")), "legendary", 1, true) ~= nil
	end
	
	local function getKindSuffixes(kind)
		local words = {}
		for word in string.lower(tostring(kind or "")):gmatch("[%w]+") do
			if not word:match("^%d+$") then
				table.insert(words, word)
			end
		end
	
		local suffixes = {}
		for firstWord = 1, #words do
			local suffix = table.concat(words, "", firstWord)
			if #suffix >= 5 then
				table.insert(suffixes, suffix)
			end
		end
		return suffixes
	end
	
	local function matchesKind(value, suffixes)
		local normalized = string.lower(tostring(value or "")):gsub("[^%w]", "")
		for _, suffix in ipairs(suffixes) do
			if string.find(normalized, suffix, 1, true) then
				return true
			end
		end
		return false
	end
	
	local function getJournalPetInfo(journal, kind)
		local suffixes = getKindSuffixes(kind)
		if #suffixes == 0 then
			return nil, false
		end
	
		local matchedImage
		for _, candidate in ipairs(journal:GetDescendants()) do
			local matches = matchesKind(candidate.Name, suffixes)
			if candidate:IsA("TextLabel") or candidate:IsA("TextButton") then
				matches = matches or matchesKind(candidate.Text, suffixes)
			end
	
			if matches then
				local current = candidate
				for _ = 1, 5 do
					if not current or current == journal then
						break
					end
	
					local legendary = isLegendary(current.Name)
					local image
					if current:IsA("ImageLabel") or current:IsA("ImageButton") then
						image = current.Image
					end
	
					for _, descendant in ipairs(current:GetDescendants()) do
						legendary = legendary or isLegendary(descendant.Name)
						if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
							legendary = legendary or isLegendary(descendant.Text)
						end
						if not image and (descendant:IsA("ImageLabel") or descendant:IsA("ImageButton")) then
							image = descendant.Image
						end
					end
	
					if image and image ~= "" then
						matchedImage = matchedImage or image
						if legendary then
							return image, true
						end
					end
					current = current.Parent
				end
			end
		end
	
		return matchedImage, false
	end
	
	local function refreshLegendaryPet()
		local playerData = getPlayerData()
		local pets = playerData and playerData.inventory and playerData.inventory.pets
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		local journal = playerGui and playerGui:FindFirstChild("JournalApp")
		if not pets or not journal then
			return
		end
	
		for _, petData in pairs(pets) do
			if petData and petData.kind then
				local image, journalLegendary = getJournalPetInfo(journal, petData.kind)
				local properties = petData.properties or {}
				local petLegendary = isLegendary(petData.rarity)
					or isLegendary(properties.rarity)
					or journalLegendary
	
				if petLegendary and image then
					ImageLabel.Image = image
					status.Text = tostring(petData.kind)
					return
				end
			end
		end
	
		ImageLabel.Image = ""
		status.Text = "No legendary pet"
	end
	
	task.spawn(function()
		while Main.Parent do
			local success, message = pcall(refreshLegendaryPet)
			if not success then
				warn("Could not refresh legendary pet image:", message)
			end
			task.wait(2)
		end
	end)
end
coroutine.wrap(BLRVIFE_fake_script)()
