local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local ClientData = require(
    ReplicatedStorage
        :WaitForChild("ClientModules")
        :WaitForChild("Core")
        :WaitForChild("ClientData")
)

local KindDB = require(
    ReplicatedStorage
        :WaitForChild("ClientDB")
        :WaitForChild("Inventory")
        :WaitForChild("KindDB")
)

local function getPlayerData()
    local data = ClientData.get_data()

    if not data then
        return nil
    end

    return data[player] or data[player.Name]
end

local function isEgg(itemData)
    if type(itemData) ~= "table" then
        return false
    end

    local kind = string.lower(tostring(itemData.kind or ""))

    local displayName = string.lower(
        tostring(
            itemData.display_name
                or itemData.displayName
                or itemData.name
                or ""
        )
    )

    local category = string.lower(
        tostring(itemData.category or "")
    )

    return itemData.is_egg == true
        or string.find(kind, "egg", 1, true) ~= nil
        or string.find(displayName, "egg", 1, true) ~= nil
        or category == "egg"
        or category == "eggs"
end

local rarityNames = {
    common = "Common",
    uncommon = "Uncommon",
    rare = "Rare",
    ultra_rare = "Ultra-Rare",
    legendary = "Legendary"
}

local function scanInventory()

    local playerData = getPlayerData()

    if not playerData then
        warn("PlayerData is not available yet.")
        return false
    end

    if not playerData.inventory then
        warn("Inventory is not available yet.")
        return false
    end

    local pets = playerData.inventory.pets

    if type(pets) ~= "table" then
        warn("inventory.pets is not available or is not a table.")
        return false
    end

    local counts = {
        Common = 0,
        Uncommon = 0,
        Rare = 0,
        ["Ultra-Rare"] = 0,
        Legendary = 0
    }

    local eggCount = 0
    local petCount = 0

    print("")
    print("====================================")
    print("===== INVENTORY SCAN =====")
    print("====================================")

    for uniqueId, itemData in pairs(pets) do

        if type(itemData) == "table" then

            local kind = itemData.kind or "UNKNOWN"
            local kindData = KindDB[kind]

            if isEgg(itemData) then

                eggCount += 1

                local eggName =
                    (kindData and kindData.name)
                    or itemData.display_name
                    or itemData.displayName
                    or itemData.name
                    or kind

                print(
                    "EGG:",
                    uniqueId,
                    "|",
                    eggName,
                    "| Kind:",
                    kind
                )

            else

                petCount += 1

                if kindData then

                    local rarity = kindData.rarity

                    local rarityName =
                        rarity
                        and rarityNames[string.lower(tostring(rarity))]

                    if rarityName then
                        counts[rarityName] += 1

                        print(
                            "PET:",
                            uniqueId,
                            "|",
                            kindData.name or kind,
                            "|",
                            rarityName
                        )
                    else
                        print(
                            "RARITY NOT FOUND:",
                            uniqueId,
                            "|",
                            kind
                        )
                    end

                else

                    print(
                        "KIND NOT FOUND:",
                        uniqueId,
                        "|",
                        kind
                    )

                end
            end
        end
    end

    print("")
    print("===== INVENTORY TOTALS =====")
    print("Eggs:", eggCount)
    print("Pets:", petCount)
    print("Common:", counts.Common)
    print("Uncommon:", counts.Uncommon)
    print("Rare:", counts.Rare)
    print("Ultra-Rare:", counts["Ultra-Rare"])
    print("Legendary:", counts.Legendary)
    print("====================================")

    return true
end

-- Wait for ClientData to become available.
task.spawn(function()

    for attempt = 1, 30 do

        if scanInventory() then
            break
        end

        task.wait(1)

    end

end)
