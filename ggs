local Config = {
    TargetUsername = "XzMysticbAClawnzX",
    PurchaseAmount = 100,
    Delay = 0.5,
}

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local furniture = Workspace
    :WaitForChild("HouseInteriors")
    :WaitForChild("furniture")

local buyRemote = ReplicatedStorage
    :WaitForChild("API")
    :WaitForChild("AvatarAPI/BuyMannequinOutfit")

local deleteRemote = ReplicatedStorage
    :WaitForChild("API")
    :WaitForChild("AvatarAPI/DeleteOutfit")

local targetPrefix = Config.TargetUsername .. "/"

local UUID_PATTERN =
    "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"

local function findTargetMannequin()
    for _, obj in ipairs(furniture:GetChildren()) do
        if obj.Name:sub(1, #targetPrefix) == targetPrefix then
            local furnitureId = obj.Name:match("(f%-.+)$")
            local mannequin = obj:FindFirstChild("Mannequin", true)

            if furnitureId and mannequin then
                return obj, furnitureId, mannequin
            end
        end
    end
end

local function findUUID(root)
    for name, value in pairs(root:GetAttributes()) do
        if typeof(value) == "string"
            and value:match(UUID_PATTERN)
        then
            return value
        end
    end

    for _, obj in ipairs(root:GetDescendants()) do
        for name, value in pairs(obj:GetAttributes()) do
            if typeof(value) == "string"
                and value:match(UUID_PATTERN)
            then
                return value
            end
        end

        if obj:IsA("StringValue")
            and obj.Value:match(UUID_PATTERN)
        then
            return obj.Value
        end
    end
end

local targetPlayer = Players:FindFirstChild(Config.TargetUsername)

if not targetPlayer then
    warn("Target player is not in the server.")
    return
end

local mannequinFolder, furnitureId, mannequin =
    findTargetMannequin()

if not mannequinFolder then
    warn("Could not find target mannequin.")
    return
end

local outfitUUID = findUUID(mannequinFolder)

if not outfitUUID then
    warn("Could not find outfit UUID.")
    return
end

print("Target:", Config.TargetUsername)
print("Furniture ID:", furnitureId)
print("Outfit UUID:", outfitUUID)

-- Buy, then delete the purchased outfit.
local success, result = pcall(function()
    return buyRemote:InvokeServer(
        targetPlayer,
        furnitureId,
        outfitUUID,
        Config.PurchaseAmount
    )
end)

if not success then
    warn("BuyMannequinOutfit failed:", result)
    return
end

print("Purchase result:", result)

task.wait(Config.Delay)

local deleteSuccess, deleteResult = pcall(function()
    return deleteRemote:FireServer(
        "player",
        "Outfit"
    )
end)

if not deleteSuccess then
    warn("DeleteOutfit failed:", deleteResult)
else
    print("Outfit deleted.")
end
