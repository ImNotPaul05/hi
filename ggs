	local potion = main:WaitForChild("Potion")
	local trading = main:WaitForChild("Trading")
	local stroke = button:WaitForChild("UIStroke")
	
	button.BackgroundColor3 = Color3.fromRGB(154, 0, 154)
	stroke.Color = Color3.fromRGB(255, 0, 255)
	
	button.Activated:Connect(function()
		potion.Visible = false
		trading.Visible = true
	end)
end
