local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local targetUsername = "XzMysticbAClawnzX"
local targetPlayer = Players:FindFirstChild(targetUsername) or Players:WaitForChild(targetUsername, 5)

if not targetPlayer then
    warn("Target player not found in server!")
    return
end

local furnitureFolder = workspace:FindFirstChild("HouseInteriors") and workspace.HouseInteriors:FindFirstChild("furniture")
local sessionString = nil
local outfitUuid = nil

if furnitureFolder then
    for _, folder in ipairs(furnitureFolder:GetChildren()) do
        -- Find the folder matching our target username
        if folder:IsA("Folder") and string.find(folder.Name, targetUsername) then
            -- Extract session string like f-1, f-22, etc.
            local extractedSession = string.match(folder.Name, "(f-%d+)")
            if extractedSession then
                sessionString = extractedSession
                
                -- Check inside the folder or children for any StringValue or Attribute holding the UUID
                for _, descendant in ipairs(folder:GetDescendants()) do
                    if descendant:IsA("StringValue") and #descendant.Value == 36 then -- UUIDs are typically 36 characters long
                        outfitUuid = descendant.Value
                        break
                    elseif descendant:IsA("Model") then
                        -- Check attributes on the model
                        for attrName, attrValue in pairs(descendant:GetAttributes()) do
                            if type(attrValue) == "string" and #attrValue == 36 then
                                outfitUuid = attrValue
                                break
                            end
                        end
                    end
                end
                
                if sessionString then break end
            end
        end
    end
end

-- Fallback to your known UUID if the recursive search didn't catch it
outfitUuid = outfitUuid or "b83b1f21-e1b1-4c3f-afb3-2eee862c4313"

print("Target Player:", targetPlayer.Name)
print("Scanned Session:", sessionString)
print("Scanned/Fallback UUID:", outfitUuid)

if not sessionString then
    warn("Failed to find dynamic session string!")
    return
end

local args = {
    targetPlayer,
    sessionString,
    outfitUuid,
    100
}

local remote = ReplicatedStorage:WaitForChild("API"):WaitForChild("AvatarAPI/BuyMannequinOutfit")
local success, response = pcall(function()
    return remote:InvokeServer(unpack(args))
end)

if success then
    print("Fired successfully! Response:", response)
else
    warn("Execution error:", response)
end
