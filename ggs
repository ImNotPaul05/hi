-- Scripts:

local function SDDB_fake_script() -- PetInterface.Petscript 
	local script = Instance.new('LocalScript', PetInterface)

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer

	local container = script.Parent:WaitForChild("PetScrollingFrame")
	local listLayout = container:WaitForChild("UIListLayout")

	-- Safe load for ClientData
	local successClientData, ClientData = pcall(function()
		return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("Core"):WaitForChild("ClientData"))
	end)

	local function updatePetList()
		-- Clear old labels first to avoid duplicates
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		if not successClientData or not ClientData then
			return
		end

		local dataStore = ClientData.get_data()
		local playerData = dataStore and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])
		
		if not playerData or not playerData.inventory or not playerData.inventory.pets then
			return
		end

		local foundPets = {}

		-- Loop through inventory pets using your data layout
		for uniqueId, itemData in pairs(playerData.inventory.pets) do
			if itemData and itemData.kind then
				local petName = itemData.kind
				local properties = itemData.properties or {}
				
				-- Format display label style (e.g., handling neon/mega markers if desired)
				local suffix = ""
				if properties.mega_neon then
					suffix = " (Mega Neon)"
				elseif properties.neon then
					suffix = " (Neon)"
				end

				local displayName = petName .. suffix
				
				if not foundPets[uniqueId] then
					foundPets[uniqueId] = displayName
				end
			end
		end

		-- Create visual text labels inside the scrolling frame
		for uniqueId, displayName in pairs(foundPets) do
			local textLabel = Instance.new("TextLabel")
			textLabel.Size = UDim2.new(1, 0, 0, 30)
			textLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
			textLabel.BackgroundTransparency = 0.2
			textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			textLabel.TextSize = 14
			textLabel.Font = Enum.Font.SourceSansBold
			textLabel.Text = displayName
			textLabel.Parent = container
		end
		
		-- Adjust canvas size automatically based on content
		container.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
	end

	-- Run continuously to keep the UI synced with inventory updates
	task.spawn(function()
		while true do
			pcall(updatePetList)
			task.wait(2) -- Refresh every 2 seconds
		end
	end)
end

coroutine.wrap(SDDB_fake_script)()
