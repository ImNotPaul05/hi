-- Scripts:

local function SDDB_fake_script() -- PetInterface.Petscript 
	local script = Instance.new('LocalScript', PetInterface)

	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

	local container = script.Parent:WaitForChild("PetScrollingFrame")
	local listLayout = container:WaitForChild("UIListLayout")

	local function updatePetList()
		-- Clear old labels first to avoid duplicates
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		local foundPets = {}

		-- Scan PlayerGui exclusively for pet inventory elements
		for _, gui in ipairs(PlayerGui:GetDescendants()) do
			if gui:IsA("TextLabel") and gui.Text ~= "" and #gui.Text > 1 then
				local fullName = gui:GetFullName():lower()
				
				-- Ensure it belongs to a pet section and excludes tools/food/toys
				if fullName:find("pet") and not fullName:find("tool") and not fullName:find("food") and not fullName:find("toy") then
					local text = gui.Text
					
					-- Filter out common static UI text elements/headers
					local ignoreList = {"pets", "inventory", "equipped", "favorite", "search", "name"}
					local isIgnored = false
					for _, word in ipairs(ignoreList) do
						if text:lower() == word then
							isIgnored = true
							break
						end
					end
					
					if not isIgnored and not foundPets[text] then
						foundPets[text] = true
					end
				end
			end
		end

		-- Create visual text labels for each found pet
		for petName, _ in pairs(foundPets) do
			local textLabel = Instance.new("TextLabel")
			textLabel.Size = UDim2.new(1, 0, 0, 30)
			textLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
			textLabel.BackgroundTransparency = 0.2
			textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			textLabel.TextSize = 14
			textLabel.Font = Enum.Font.SourceSansBold
			textLabel.Text = petName
			textLabel.Parent = container
		end
		
		-- Adjust canvas size automatically based on content
		container.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
	end

	-- Run initially
	task.spawn(updatePetList)
	
	-- Optional periodic refresh to catch newly opened menus or loaded pets
	task.spawn(function()
		while true do
			task.wait(3)
			pcall(updatePetList)
		end
	end)
end

coroutine.wrap(SDDB_fake_script)()
