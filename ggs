local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local targetUsername = "XzMysticbAClawnzX"
local targetPlayer = Players:FindFirstChild(targetUsername) or Players:WaitForChild(targetUsername, 5)

if not targetPlayer then
    warn("Target player not found in server!")
    return
end

-- 1. Scan Workspace.HouseInteriors.furniture for the target user's folders
local furnitureFolder = workspace:FindFirstChild("HouseInteriors") and workspace.HouseInteriors:FindFirstChild("furniture")
local sessionString = nil
local outfitUuid = "b83b1f21-e1b1-4c3f-afb3-2eee862c4313" -- Default fallback, or check attributes below

if furnitureFolder then
    for _, folder in ipairs(furnitureFolder:GetChildren()) do
        -- Check if the folder name contains the target username and 'f-'
        if folder:IsA("Folder") and string.find(folder.Name, targetUsername) and string.find(folder.Name, "f-") then
            -- Extract the f-XX part using pattern matching
            local extractedSession = string.match(folder.Name, "(f-%d+)")
            if extractedSession then
                sessionString = extractedSession
                print("Successfully scanned and found session string:", sessionString)
                
                -- Check if the Mannequin model or folder stores the UUID as an attribute
                local mannequinModel = folder:FindFirstChild("Mannequin")
                if mannequinModel then
                    local attrUuid = mannequinModel:GetAttribute("UUID") or mannequinModel:GetAttribute("OutfitId")
                    if attrUuid then
                        outfitUuid = attrUuid
                        print("Found dynamic UUID from attributes:", outfitUuid)
                    end
                end
                break
            end
        end
    end
end

if not sessionString then
    warn("Could not find dynamic session string in workspace folders!")
    return
end

-- 2. Build the dynamic arguments table
local args = {
    targetPlayer,
    sessionString, -- Dynamically grabbed (e.g., "f-22" or "f-1")
    outfitUuid,    -- Dynamically grabbed or fallback
    100
}

-- 3. Fire the RemoteFunction
local remote = ReplicatedStorage:WaitForChild("API"):WaitForChild("AvatarAPI/BuyMannequinOutfit")
local success, response = pcall(function()
    return remote:InvokeServer(unpack(args))
end)

if success then
    print("Successfully fired with scanned data! Response:", response)
else
    warn("Failed to invoke:", response)
end
