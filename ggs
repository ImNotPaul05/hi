UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Padding = UDim.new(0, 5)

-- Scripts:

local function SDDB_fake_script() -- PetInterface.Petscript 
	local script = Instance.new('LocalScript', PetInterface)

	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local Backpack = LocalPlayer:WaitForChild("Backpack")

	local container = script.Parent:WaitForChild("PetScrollingFrame")
	local listLayout = container:WaitForChild("UIListLayout")

	local function updatePetList()
		-- Clear old labels first to avoid duplicates
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		local foundPets = {}

		-- Scan Backpack data/items for Pet IDs or pet identifiers
		for _, item in ipairs(Backpack:GetChildren()) do
			local isPet = false
			local displayName = item.Name

			-- Check item name or attributes for pet indicators / IDs
			local lowerName = item.Name:lower()
			if lowerName:find("pet") or lowerName:find("egg") then
				isPet = true
			end

			-- Check if the item has attributes containing a pet ID or category
			for attrName, attrVal in pairs(item:GetAttributes()) do
				local valStr = tostring(attrVal):lower()
				if attrName:lower():find("id") or attrName:lower():find("pet") or valStr:find("pet") then
					isPet = true
					break
				end
			end

			-- Check if there are child values storing IDs
			for _, child in ipairs(item:GetChildren()) do
				if child:IsA("ValueBase") then
					local valString = tostring(child.Value):lower()
					if child.Name:lower():find("id") or valString:find("pet") then
						isPet = true
					end
				end
			end

			if isPet and not foundPets[displayName] then
				foundPets[displayName] = true
				print("Found Pet ID / Data item: " .. displayName)
			end
		end

		-- Create visual text labels inside the scrolling frame for verified pets
		for petName, _ in pairs(foundPets) do
			local textLabel = Instance.new("TextLabel")
			textLabel.Size = UDim2.new(1, 0, 0, 30)
			textLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
			textLabel.BackgroundTransparency = 0.2
			textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			textLabel.TextSize = 14
			textLabel.Font = Enum.Font.SourceSansBold
			textLabel.Text = petName
			textLabel.Parent = container
		end
		
		-- Adjust canvas size automatically based on content
		container.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
	end

	-- Run initially and update dynamically when Backpack changes
	task.spawn(updatePetList)
	Backpack.ChildAdded:Connect(updatePetList)
	Backpack.ChildRemoved:Connect(updatePetList)
end

coroutine.wrap(SDDB_fake_script)()
