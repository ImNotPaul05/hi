local Config = {
    TargetUsername = "XzMysticbAClawnzX",
}

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local API = ReplicatedStorage:WaitForChild("API")

local furniture = Workspace
    :WaitForChild("HouseInteriors")
    :WaitForChild("furniture")


--==================================================
-- LOAD TARGET HOUSE
--==================================================

local targetPlayer = Players:WaitForChild(Config.TargetUsername)

local args = {
    targetPlayer
}

API:WaitForChild("HousingAPI/SubscribeToHouse")
    :FireServer(unpack(args))

print("Loading house for:", Config.TargetUsername)


--==================================================
-- WAIT FOR TARGET HOUSE
--==================================================

local targetPrefix = Config.TargetUsername .. "/"
local houseFolder

repeat
    task.wait(0.2)

    for _, obj in ipairs(furniture:GetChildren()) do
        if obj.Name:sub(1, #targetPrefix) == targetPrefix then
            houseFolder = obj
            break
        end
    end
until houseFolder

print("Target house loaded:", houseFolder:GetFullName())


--==================================================
-- FIND MANNEQUIN
--==================================================

local mannequin = houseFolder:FindFirstChild("Mannequin", true)

if mannequin then
    print("Mannequin found:", mannequin:GetFullName())
else
    warn("No mannequin found in target house.")
end


--==================================================
-- INSPECT HOUSE CONTENTS
--==================================================

print("=== TARGET HOUSE CONTENTS ===")

for _, obj in ipairs(houseFolder:GetDescendants()) do
    print(
        obj.ClassName,
        "->",
        obj.Name,
        "->",
        obj:GetFullName()
    )

    for name, value in pairs(obj:GetAttributes()) do
        print("    Attribute:", name, "=", value)
    end

    if obj:IsA("StringValue") then
        print("    StringValue:", obj.Value)
    end
end

print("=== END ===")
