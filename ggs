local Config = {
    TargetUsername = "XzMysticbAClawnzX",
}

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local API = ReplicatedStorage:WaitForChild("API")

local furniture = Workspace
    :WaitForChild("HouseInteriors")
    :WaitForChild("furniture")


--==================================================
-- LOAD TARGET HOUSE
--==================================================

local targetPlayer = Players:WaitForChild(Config.TargetUsername)

API:WaitForChild("HousingAPI/SubscribeToHouse")
    :FireServer(targetPlayer)

print("Loading house for:", Config.TargetUsername)


--==================================================
-- WAIT FOR TARGET HOUSE
--==================================================

local targetPrefix = Config.TargetUsername .. "/"

repeat
    task.wait(0.2)

    local found = false

    for _, obj in ipairs(furniture:GetChildren()) do
        if obj.Name:sub(1, #targetPrefix) == targetPrefix then
            found = true
            break
        end
    end

until found

print("Target house loaded")


--==================================================
-- SEARCH ALL TARGET FURNITURE
--==================================================

print("Searching target furniture...")

local mannequinFolder
local mannequin
local furnitureId

for _, obj in ipairs(furniture:GetChildren()) do

    if obj.Name:sub(1, #targetPrefix) == targetPrefix then

        local id = obj.Name:match("(f%-.+)$")
        local foundMannequin = obj:FindFirstChild("Mannequin", true)

        if id then
            print(
                "Furniture:",
                id,
                "|",
                obj:GetFullName()
            )
        end

        if foundMannequin then
            mannequinFolder = obj
            mannequin = foundMannequin
            furnitureId = id

            print("================================")
            print("MANNEQUIN FOUND")
            print("Furniture ID:", furnitureId)
            print("Mannequin:", mannequin:GetFullName())
            print("================================")

            break
        end
    end
end


if not mannequin then
    warn("No mannequin found in target player's loaded house.")
else
    print("Ready for next step.")
end
