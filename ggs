local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

targetUsername = "XzMysticbAClawnzX"
local targetPlayer = Players:FindFirstChild(targetUsername) or Players:WaitForChild(targetUsername, 5)

if not targetPlayer then
    warn("Target player not found in server!")
    return
end

local furnitureFolder = workspace:FindFirstChild("HouseInteriors") and workspace.HouseInteriors:FindFirstChild("furniture")
local sessionString = nil
local correctOutfitUuid = nil

if furnitureFolder then
    -- Recursively search through every single subfolder and descendant
    for _, descendant in ipairs(furnitureFolder:GetDescendants()) do
        -- 1. Look for the session string (e.g., f-1, f-22) in any folder or object name
        if not sessionString and string.find(descendant.Name, "f-") then
            local extracted = string.match(descendant.Name, "(f-%d+)")
            if extracted then
                sessionString = extracted
            end
        end
        
        -- 2. Look for a UUID (36-character string) hidden in values or attributes
        if not correctOutfitUuid then
            if descendant:IsA("StringValue") and #descendant.Value == 36 then
                correctOutfitUuid = descendant.Value
            else
                for _, attrVal in pairs(descendant:GetAttributes()) do
                    if type(attrVal) == "string" and #attrVal == 36 then
                        correctOutfitUuid = attrVal
                        break
                    end
                end
            end
        end
        
        if sessionString and correctOutfitUuid then
            break
        end
    end
end

-- If the UUID still couldn't be auto-scanned from the folder, you can hardcode just the UUID 
-- while letting the script automatically grab the correct session string (f-XX).
correctOutfitUuid = correctOutfitUuid or "b83b1f21-e1b1-4c3f-afb3-2eee862c4313"

print("Deep-Scanned Session:", tostring(sessionString))
print("Deep-Scanned UUID:", tostring(correctOutfitUuid))

if not sessionString then
    warn("Could not find session string! Make sure you are near the target house.")
    return
end

local args = {
    targetPlayer,
    sessionString,
    correctOutfitUuid,
    100
}

local remote = ReplicatedStorage:WaitForChild("API"):WaitForChild("AvatarAPI/BuyMannequinOutfit")
local success, response = pcall(function()
    return remote:InvokeServer(unpack(args))
end)

if success then
    print("Successfully fired! Response:", response)
else
    warn("Failed to invoke:", response)
end
