local Config = {
    TargetUsername = "XzMysticbAClawnzX",
}

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local furniture = Workspace
    :WaitForChild("HouseInteriors")
    :WaitForChild("furniture")

local targetPrefix = Config.TargetUsername .. "/"

local UUID_PATTERN =
    "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"

local mannequinFolder
local furnitureId
local mannequin

-- Find target's f-* furniture containing a Mannequin
for _, obj in ipairs(furniture:GetChildren()) do
    if obj.Name:sub(1, #targetPrefix) == targetPrefix then

        local id = obj.Name:match("(f%-.+)$")

        if id then
            local foundMannequin =
                obj:FindFirstChild("Mannequin", true)

            if foundMannequin then
                mannequinFolder = obj
                furnitureId = id
                mannequin = foundMannequin
                break
            end
        end
    end
end

if not mannequinFolder then
    warn("No matching mannequin found for " .. Config.TargetUsername)
    return
end

-- Find UUID
local function findUUID(root)
    for name, value in pairs(root:GetAttributes()) do
        if typeof(value) == "string"
            and value:match(UUID_PATTERN)
        then
            return value
        end
    end

    for _, obj in ipairs(root:GetDescendants()) do

        for name, value in pairs(obj:GetAttributes()) do
            if typeof(value) == "string"
                and value:match(UUID_PATTERN)
            then
                return value
            end
        end

        if obj:IsA("StringValue")
            and obj.Value:match(UUID_PATTERN)
        then
            return obj.Value
        end
    end

    return nil
end

local outfitUUID = findUUID(mannequinFolder)

if not outfitUUID then
    warn("Could not find outfit UUID.")
    return
end

print("Target:", Config.TargetUsername)
print("Furniture ID:", furnitureId)
print("Outfit UUID:", outfitUUID)
print("Mannequin:", mannequin:GetFullName())

-- Call API
local targetPlayer = game:GetService("Players")
    :FindFirstChild(Config.TargetUsername)

if not targetPlayer then
    warn("Target player is not currently in the server.")
    return
end

local remote = ReplicatedStorage
    :WaitForChild("API")
    :WaitForChild("AvatarAPI/BuyMannequinOutfit")

local result = remote:InvokeServer(
    targetPlayer,
    furnitureId,
    outfitUUID,
    100
)

print("API result:", result)
