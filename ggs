local Config = {
    TargetUsername = "XzMysticbAClawnzX",
}

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local API = ReplicatedStorage:WaitForChild("API")

local furniture = Workspace
    :WaitForChild("HouseInteriors")
    :WaitForChild("furniture")


--==================================================
-- LOAD TARGET HOUSE
--==================================================

local targetPlayer = Players:WaitForChild(Config.TargetUsername)

local args = {
    targetPlayer
}

API:WaitForChild("HousingAPI/SubscribeToHouse")
    :FireServer(unpack(args))

print("Loading house for:", Config.TargetUsername)


--==================================================
-- WAIT FOR TARGET HOUSE
--==================================================

local targetPrefix = Config.TargetUsername .. "/"
local houseFolder

repeat
    task.wait(0.2)

    for _, obj in ipairs(furniture:GetChildren()) do
        if obj.Name:sub(1, #targetPrefix) == targetPrefix then
            houseFolder = obj
            break
        end
    end
until houseFolder

print("Target house loaded:", houseFolder:GetFullName())


--==================================================
-- FIND MANNEQUIN
--==================================================

local mannequin = houseFolder:FindFirstChild("Mannequin", true)

if mannequin then
    print("Mannequin found:", mannequin:GetFullName())
else
    warn("No mannequin found in target house.")
end


--==================================================
-- INSPECT HOUSE CONTENTS
--==================================================

--==================================================
-- WAIT FOR FURNITURE CONTENTS
--==================================================

print("Waiting for furniture contents...")

local timeout = 15
local startTime = os.clock()

repeat
    task.wait(0.25)

    if #houseFolder:GetChildren() > 0 then
        break
    end
until os.clock() - startTime >= timeout

print("Children found:", #houseFolder:GetChildren())


--==================================================
-- INSPECT TARGET FURNITURE
--==================================================

print("=== TARGET FURNITURE ===")

for _, obj in ipairs(houseFolder:GetChildren()) do
    print(
        obj.ClassName,
        "->",
        obj.Name,
        "->",
        obj:GetFullName()
    )
end

print("=== DESCENDANTS ===")

for _, obj in ipairs(houseFolder:GetDescendants()) do
    print(
        obj.ClassName,
        "->",
        obj.Name,
        "->",
        obj:GetFullName()
    )
end

print("=== END ===")
