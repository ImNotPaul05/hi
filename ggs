local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TargetUsername = "XzMysticbAClawnzX"

local targetPlayer = Players:WaitForChild(TargetUsername)

-- Load target house
local args = {
    targetPlayer
}

ReplicatedStorage:WaitForChild("API")
    :WaitForChild("HousingAPI/SubscribeToHouse")
    :FireServer(unpack(args))

print("Loading house for:", TargetUsername)

-- Find furniture folder
local furniture = workspace
    :WaitForChild("HouseInteriors")
    :WaitForChild("furniture")

-- Wait for target furniture to appear
local targetPrefix = TargetUsername .. "/"
local houseFolder

repeat
    task.wait(0.2)

    for _, obj in ipairs(furniture:GetChildren()) do
        if obj.Name:sub(1, #targetPrefix) == targetPrefix then
            houseFolder = obj
            break
        end
    end
until houseFolder

print("Target house loaded:", houseFolder:GetFullName())

-- Find mannequin
local mannequin = houseFolder:FindFirstChild("Mannequin", true)

if not mannequin then
    warn("No mannequin found in target house")
    return
end

print("Mannequin found:", mannequin:GetFullName())

-- Inspect mannequin
for name, value in pairs(mannequin:GetAttributes()) do
    print("Attribute:", name, "=", value)
end

for _, obj in ipairs(mannequin:GetDescendants()) do
    print(obj.ClassName, obj:GetFullName())

    for name, value in pairs(obj:GetAttributes()) do
        print("  Attribute:", name, "=", value)
    end

    if obj:IsA("StringValue") then
        print("  StringValue:", obj.Value)
    end
end
