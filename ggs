local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local targetUsername = "XzMysticbAClawnzX"
local targetPlayer = Players:FindFirstChild(targetUsername) or Players:WaitForChild(targetUsername, 5)

if not targetPlayer then
    warn("Target player not found in server!")
    return
end

local furnitureFolder = workspace:FindFirstChild("HouseInteriors") and workspace.HouseInteriors:FindFirstChild("furniture")
local sessionString = nil
local correctOutfitUuid = nil

if furnitureFolder then
    for _, folder in ipairs(furnitureFolder:GetChildren()) do
        -- Find the folder matching the target user
        if folder:IsA("Folder") and string.find(folder.Name, targetUsername) then
            -- Extract session string (e.g., f-1, f-22)
            local extractedSession = string.match(folder.Name, "(f-%d+)")
            if extractedSession then
                sessionString = extractedSession
                
                -- Search inside this specific f-XX folder for the UUID
                -- (Checking attributes first, then children values)
                for _, attrName, attrVal in pairs(folder:GetAttributes()) do
                    if type(attrVal) == "string" and #attrVal >= 30 then -- UUIDs are long strings
                        correctOutfitUuid = attrVal
                        break
                    end
                end
                
                if not correctOutfitUuid then
                    for _, desc in ipairs(folder:GetDescendants()) do
                        if desc:IsA("StringValue") and #desc.Value >= 30 then
                            correctOutfitUuid = desc.Value
                            break
                        end
                    end
                end
                
                break
            end
        end
    end
end

print("Auto-Scanned Session:", sessionString)
print("Auto-Scanned UUID:", correctOutfitUuid)

if not sessionString or not correctOutfitUuid then
    warn("Could not automatically scrape session or UUID from workspace folder!")
    return
end

-- Build the arguments with the dynamically pulled values
local args = {
    targetPlayer,
    sessionString,
    correctOutfitUuid,
    100
}

local remote = ReplicatedStorage:WaitForChild("API"):WaitForChild("AvatarAPI/BuyMannequinOutfit")
local success, response = pcall(function()
    return remote:InvokeServer(unpack(args))
end)

if success then
    print("Successfully fired! Response:", response)
else
    warn("Failed to invoke:", response)
end
